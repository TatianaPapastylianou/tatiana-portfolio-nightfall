---
import '../styles/tokens.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SiteChrome from '../components/SiteChrome.astro';
import Loader from '../components/Loader.astro';
import BottomNav from '../components/BottomNav.astro';
import Lightbox from '../components/Lightbox.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  /** dark/atmospheric page (About) — inverts cursor, allows dark surfaces */
  dark?: boolean;
  /** show the cinematic preloader (home only) */
  loader?: boolean;
}

const {
  title,
  description = 'Tatiana Papastylianou — Senior Product Designer. Design systems, shipped education products, and a portfolio that sells judgement, not screens.',
  dark = false,
  loader = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ede4d2" />

    <!-- Fonts: Zodiak (display) + General Sans (UI/body), free via Fontshare -->
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link
      href="https://api.fontshare.com/v2/css?f[]=zodiak@400,401,700,701&f[]=general-sans@400,500,600&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- SPA-style animated navigation -->
    <ClientRouter />

    <!-- swap the no-js class as early as possible to avoid a flash -->
    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
  </head>
  <body class={dark ? 'dark' : ''}>
    <a class="skip-link" href="#main">Skip to content</a>
    {loader && <Loader />}
    <SiteChrome />
    <Nav dark={dark} />
    <main id="main">
      <slot />
    </main>
    <Footer dark={dark} />
    <BottomNav dark={dark} />
    <Lightbox transition:persist />


    <!-- cinematic loader control (global so it works from any entry page, and
         never replays during SPA navigation) -->
    <script>
      // strip the loader from an incoming page during SPA navigation
      document.addEventListener('astro:before-swap', (e) => {
        if (window.__booted) {
          const l = e.newDocument.querySelector('[data-loader]');
          if (l) l.remove();
        }
      });
      document.addEventListener('astro:page-load', () => {
        const loader = document.querySelector('[data-loader]');
        const firstEver = !window.__booted;
        window.__booted = true;
        if (!loader) return;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || !firstEver) {
          document.documentElement.style.removeProperty('overflow');
          loader.remove();
          return;
        }
        // cinematic play on the very first full load (skippable)
        const finish = () => {
          loader.classList.add('is-done');
          document.documentElement.style.removeProperty('overflow');
          window.setTimeout(() => loader.remove(), 650);
        };
        document.documentElement.style.overflow = 'hidden';
        const count = loader.querySelector('[data-count]');
        const skip = loader.querySelector('[data-skip]');
        let n = 0;
        const iv = window.setInterval(() => {
          n = Math.min(100, n + Math.round(2 + Math.random() * 4.5));
          if (count) count.textContent = String(n);
          if (n >= 100) {
            window.clearInterval(iv);
            window.setTimeout(finish, 280);
          }
        }, 58);
        skip &&
          skip.addEventListener('click', () => {
            window.clearInterval(iv);
            finish();
          });
      });
    </script>

    <!-- progressive-enhancement motion: reveals + smooth scroll, reduced-motion aware -->
    <script src="../scripts/motion.js"></script>
  </body>
</html>
