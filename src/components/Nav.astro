---
interface Props {
  dark?: boolean;
}
const { dark = false } = Astro.props;

const path = Astro.url.pathname;
const isActive = (match: string) => (match === '/' ? path === '/' : path.startsWith(match));

const links = [
  { href: '/work/design-system', label: 'Work', match: '/work' },
  { href: '/craft', label: 'Craft', match: '/craft' },
  { href: '/about', label: 'About', match: '/about' },
];
const linkedin = 'https://www.linkedin.com/in/tatiana-papastylianou-8b67a5193/';
---

<header class:list={['site-nav', { dark }]}>
  <div class="container nav-inner">
    <a href="/" class="brand" aria-label="Tatiana Papastylianou — home">
      <span class="brand-full">Tatiana Papastylianou</span>
      <span class="brand-short" aria-hidden="true">TP</span>
    </a>

    <nav class="nav-links" aria-label="Primary">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={['nav-link', 'nav-primary', { 'is-active': isActive(l.match) }]}
            aria-current={isActive(l.match) ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
      <a class="nav-link" href="/Tatiana-Papastylianou-CV.pdf" target="_blank" rel="noopener">CV</a>
      <a class="nav-link nav-ext" href={linkedin} target="_blank" rel="noopener">
        LinkedIn <span aria-hidden="true">↗</span>
      </a>
    </nav>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 120;
    backdrop-filter: blur(9px);
    background: color-mix(in srgb, var(--paper) 80%, transparent);
    border-bottom: 1px solid var(--line);
  }
  .site-nav.dark {
    background: color-mix(in srgb, var(--char) 74%, transparent);
    border-bottom-color: rgba(239, 230, 212, 0.14);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    height: 70px;
  }

  .brand {
    font-family: var(--serif);
    font-size: 1.3rem;
    letter-spacing: 0.005em;
    color: var(--head);
    white-space: nowrap;
  }
  .dark .brand {
    color: var(--on-dark);
  }
  .brand-short {
    display: none;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(0.35rem, 1.6vw, 1rem);
  }

  .nav-link {
    position: relative;
    font-size: var(--step--1);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
    padding: 0.55rem 0.7rem;
    border-radius: 22px;
    transition:
      color 0.2s var(--ease-out),
      background 0.2s var(--ease-out);
  }
  .nav-link:hover,
  .nav-link.is-active {
    color: var(--head);
    background: color-mix(in srgb, var(--ink) 7%, transparent);
  }
  .dark .nav-link {
    color: var(--on-dark-dim);
  }
  .dark .nav-link:hover,
  .dark .nav-link.is-active {
    color: var(--on-dark);
    background: color-mix(in srgb, var(--on-dark) 12%, transparent);
  }

  /* on mobile the primary links live in the floating bottom bar */
  @media (max-width: 720px) {
    .nav-primary {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .nav-link {
      letter-spacing: 0.08em;
      padding: 0.5rem 0.45rem;
    }
  }
  @media (max-width: 520px) {
    .brand-full {
      display: none;
    }
    .brand-short {
      display: inline;
      font-size: 1.3rem;
      letter-spacing: 0.04em;
    }
    .nav-link {
      font-size: 0.72rem;
      letter-spacing: 0.06em;
    }
  }
</style>
