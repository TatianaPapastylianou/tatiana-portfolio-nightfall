---
interface Props {
  dark?: boolean;
}
const { dark = false } = Astro.props;
const year = new Date().getFullYear();
const linkedin = 'https://www.linkedin.com/in/tatiana-papastylianou-8b67a5193/';
---

<footer class:list={['site-footer', { dark }]}>
  <div class="container footer-inner">
    <div class="footer-lead">
      <p class="kicker">Open to senior product design roles — remote</p>
      <a class="footer-mail" href="mailto:tatiana.papastylianou@gmail.com"
        >tatiana.papastylianou@gmail.com</a
      >
    </div>

    <nav class="footer-links" aria-label="Footer">
      <a href="/work/design-system">Work</a>
      <a href="/craft">Craft</a>
      <a href="/about">About</a>
      <a href="/Tatiana-Papastylianou-CV.pdf" target="_blank" rel="noopener">CV</a>
      <a href={linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
    </nav>
  </div>
  <div class="container footer-fine">
    <span>© {year} Tatiana Papastylianou</span>
    <span class="footer-note">Built with Astro — hung by hand.</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-2xl);
    border-top: 1px solid var(--line);
    background: var(--paper-2);
    padding-block: var(--space-xl) var(--space-l);
  }
  .site-footer.dark {
    background: var(--char);
    border-top-color: rgba(239, 230, 212, 0.14);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-l);
    align-items: flex-end;
    justify-content: space-between;
  }

  .footer-mail {
    display: inline-block;
    margin-top: 0.6rem;
    font-family: var(--serif);
    font-size: var(--step-2);
    color: var(--head);
  }
  .footer-mail:hover {
    opacity: 0.62;
  }
  .dark .footer-mail {
    color: var(--on-dark);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
  }
  .footer-links a {
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .footer-links a:hover {
    color: var(--head);
  }
  .dark .footer-links a {
    color: var(--on-dark-dim);
  }
  .dark .footer-links a:hover {
    color: var(--on-dark);
  }

  .footer-fine {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    justify-content: space-between;
    margin-top: var(--space-xl);
    color: var(--faint);
    font-size: var(--step--1);
  }
  .dark .footer-fine {
    color: var(--on-dark-dim);
  }
</style>
