---
/**
 * LiveComponents — the home hero panel, rebuilt to match the REAL Akelius
 * design-system components (pulled from the Figma component library, node ids
 * noted). Verdana, on the real tokens:
 *   segmented "group button" — selected segment #d0efff, navy #172b53 text
 *   iOS toggle — green #00a57c on, white squircle knob
 *   text field — grey label, leading search, navy #172b53 focus, clear ✕
 *   download button — #d0efff pill, "download all" + size, navy
 * These are live, keyboard-operable components — not a screenshot.
 */
---

<div class="livepanel" role="group" aria-label="Live design-system components">
  <div class="lp-title">Fractions<small>Lesson 3 · pick your level</small></div>

  <!-- group button (segmented) -->
  <div class="seg" role="tablist" aria-label="Difficulty level" data-seg>
    <button type="button" role="tab" aria-selected="true" class="on">easy</button>
    <button type="button" role="tab" aria-selected="false">medium</button>
    <button type="button" role="tab" aria-selected="false">hard</button>
  </div>

  <!-- iOS toggle -->
  <div class="row">
    <span class="lp-lbl" id="dm-lbl">dark mode</span>
    <button
      type="button"
      class="tgl"
      role="switch"
      aria-checked="false"
      aria-labelledby="dm-lbl"
      data-tgl
    >
      <span class="knob"></span>
    </button>
  </div>

  <!-- text field (search variant, navy focus, clear ✕) -->
  <label class="tf" data-tf>
    <span class="tf-label">search lessons</span>
    <span class="tf-box">
      <svg class="tf-lead" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
        ><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg
      >
      <input class="tf-input" type="text" placeholder="fractions…" />
      <button type="button" class="tf-clear" aria-label="Clear" data-clear>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
          ><path d="M6 6l12 12M18 6L6 18"></path></svg
        >
      </button>
    </span>
  </label>

  <!-- download button -->
  <button type="button" class="dlbtn" data-dl>
    <span class="fill" aria-hidden="true"></span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
      ><path d="M12 3v12m0 0l-4-4m4 4l4-4M4 21h16"></path></svg
    >
    <span class="t2">download</span><span class="sz">3.5MB</span>
  </button>
</div>

<style>
  .livepanel {
    width: 100%;
    height: 100%;
    background: #fbfcfd;
    padding: 8% 9%;
    display: flex;
    flex-direction: column;
    gap: 6%;
    justify-content: center;
    /* scale the whole panel to the frame window so it never clips. */
    font-size: clamp(9px, 2.2vw, 14px);
    font-size: clamp(8px, 5.2cqh, 15px);
    font-family: var(--sysfont);
  }
  .livepanel * {
    font-family: var(--sysfont);
  }
  .lp-title {
    font-weight: 700;
    color: var(--blue);
    font-size: 1.3em;
    line-height: 1.1;
  }
  .lp-title small {
    display: block;
    font-weight: 400;
    color: #67696a;
    font-size: 0.56em;
    letter-spacing: 0.2px;
    margin-top: 0.35em;
    white-space: nowrap;
  }

  /* group button — pill container; the selected segment is clipped to the
     container's rounding on its outer edge only (no per-button pill). */
  .seg {
    display: flex;
    background: #fff;
    border: 1px solid var(--off);
    border-radius: 999px;
    overflow: hidden;
  }
  .seg button {
    flex: 1;
    border: none;
    background: transparent;
    color: var(--blue);
    font-size: 0.95em;
    padding: 0.62em 0.2em;
    transition: background 0.18s var(--ease-out);
  }
  .seg button:not(:first-child) {
    border-left: 1px solid var(--off);
  }
  .seg button.on {
    background: var(--blueBg);
  }
  .seg button.on,
  .seg button.on + button {
    border-left-color: transparent;
  }

  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6em;
  }
  .lp-lbl {
    color: #3d4b63;
    font-weight: 400;
  }

  /* iOS glass toggle (real component): a light track → green, with a wide
     white glass capsule knob; on press the knob stretches + a soft ring glows. */
  .tgl {
    width: 3.6em;
    height: 2.05em;
    border-radius: 1.025em;
    background: #e9ebee;
    box-shadow: inset 0 0 0 1px rgba(23, 43, 83, 0.06);
    position: relative;
    flex: none;
    border: none;
    padding: 0;
    transition:
      background 0.3s var(--ease-out),
      box-shadow 0.2s var(--ease-out);
  }
  .tgl.on {
    background: var(--green);
    box-shadow: inset 0 0 0 1px rgba(0, 122, 92, 0.28);
  }
  /* the "on" indicator line, revealed on the left of the green track */
  .tgl::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0.95em;
    transform: translate(-50%, -50%);
    width: 2.5px;
    height: 0.66em;
    border-radius: 2px;
    background: #fff;
    opacity: 0;
    transition: opacity 0.28s var(--ease-out);
  }
  .tgl.on::before {
    opacity: 0.85;
  }
  /* the wide glass capsule knob */
  .tgl .knob {
    position: absolute;
    top: 0.2em;
    left: 0.2em;
    width: 2.02em;
    height: 1.65em;
    border-radius: 0.78em;
    background: linear-gradient(180deg, #ffffff 0%, #eef1f4 100%);
    box-shadow:
      0 3px 6px rgba(0, 0, 0, 0.2),
      0 0 0 0.5px rgba(0, 0, 0, 0.04),
      inset 0 1px 0 rgba(255, 255, 255, 0.95);
    transition:
      left 0.34s cubic-bezier(0.4, 1.15, 0.5, 1),
      width 0.22s var(--ease-out);
  }
  .tgl.on .knob {
    left: calc(100% - 2.22em);
  }
  /* press: knob stretches wider + a soft glow ring (glass interaction) */
  .tgl:active .knob {
    width: 2.4em;
  }
  .tgl.on:active .knob {
    left: calc(100% - 2.6em);
  }
  .tgl:active {
    box-shadow: 0 0 0 5px rgba(23, 43, 83, 0.1);
  }
  .tgl.on:active {
    box-shadow: 0 0 0 5px rgba(0, 165, 124, 0.2);
  }

  /* text field — grey label, leading search, navy focus, clear ✕ */
  .tf {
    display: flex;
    flex-direction: column;
    gap: 0.35em;
  }
  .tf-label {
    color: #67696a;
    font-size: 0.82em;
    padding-left: 0.15em;
  }
  .tf-box {
    display: flex;
    align-items: center;
    gap: 0.5em;
    background: #fff;
    border: 1.5px solid var(--off);
    border-radius: 0.6em;
    padding: 0.55em 0.7em;
    transition: border-color 0.18s;
  }
  .tf-box:focus-within {
    border-color: var(--blue);
  }
  .tf:focus-within .tf-label {
    color: var(--blue);
  }
  .tf-lead {
    width: 1.05em;
    height: 1.05em;
    color: #8a94a2;
    flex: none;
  }
  .tf-box:focus-within .tf-lead {
    color: var(--blue);
  }
  .tf-input {
    flex: 1;
    min-width: 0;
    border: none;
    outline: none;
    background: transparent;
    font-size: 1em;
    color: #1b2430;
  }
  .tf-clear {
    flex: none;
    border: none;
    background: none;
    padding: 0;
    color: #8a94a2;
    width: 1.05em;
    height: 1.05em;
    opacity: 0;
    transition: opacity 0.15s;
  }
  .tf-clear svg {
    width: 100%;
    height: 100%;
  }
  .tf.has-text .tf-clear {
    opacity: 1;
  }

  /* download button — #d0efff pill, navy */
  .dlbtn {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: 0.34em;
    background: var(--blueBg);
    color: var(--blue);
    border: none;
    border-radius: 999px;
    padding: 0.62em 0.72em;
    font-weight: 700;
    font-size: 0.92em;
    width: 100%;
  }
  .dlbtn .fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    background: rgba(24, 95, 165, 0.16);
    transition: width 0.05s linear;
  }
  .dlbtn svg {
    width: 1.5em; /* ~24px at the 16px component base */
    height: 1.5em;
    flex: none; /* don't let the flex row squish it */
    position: relative;
    z-index: 1;
  }
  .dlbtn .t2 {
    position: relative;
    z-index: 1;
    white-space: nowrap;
  }
  .dlbtn .sz {
    position: relative;
    z-index: 1;
    margin-left: auto;
    color: #6f86a3;
    font-weight: 500;
    font-size: 0.9em;
    white-space: nowrap;
  }
</style>

<script>
  // wire every live panel; idempotent, re-run on each View-Transitions navigation
  function wireLivePanels() {
    document.querySelectorAll<HTMLElement>('.livepanel').forEach((panel) => {
    if (panel.dataset.wired) return;
    panel.dataset.wired = '1';

    // group button (segmented)
    const seg = panel.querySelector('[data-seg]');
    seg?.querySelectorAll('button').forEach((b) => {
      b.addEventListener('click', () => {
        seg.querySelectorAll('button').forEach((x) => {
          x.classList.remove('on');
          x.setAttribute('aria-selected', 'false');
        });
        b.classList.add('on');
        b.setAttribute('aria-selected', 'true');
      });
    });

    // iOS toggle
    const tgl = panel.querySelector<HTMLElement>('[data-tgl]');
    tgl?.addEventListener('click', () => {
      const on = tgl.classList.toggle('on');
      tgl.setAttribute('aria-checked', on ? 'true' : 'false');
    });

    // text field — show clear ✕ when there's text; clear on click
    const tf = panel.querySelector<HTMLElement>('[data-tf]');
    const input = tf?.querySelector<HTMLInputElement>('.tf-input');
    const clear = tf?.querySelector<HTMLElement>('[data-clear]');
    const sync = () => tf?.classList.toggle('has-text', !!input?.value);
    input?.addEventListener('input', sync);
    clear?.addEventListener('click', () => {
      if (input) {
        input.value = '';
        input.focus();
      }
      sync();
    });

    // download button with progress fill
    const dl = panel.querySelector<HTMLElement>('[data-dl]');
    if (dl) {
      const fill = dl.querySelector<HTMLElement>('.fill');
      const t2 = dl.querySelector<HTMLElement>('.t2');
      const sz = dl.querySelector<HTMLElement>('.sz');
      let busy = false;
      dl.addEventListener('click', () => {
        if (busy || !fill || !t2 || !sz) return;
        busy = true;
        t2.textContent = 'downloading';
        let p = 0;
        const iv = setInterval(() => {
          p += 3;
          fill.style.width = p + '%';
          sz.textContent = ((3.5 * p) / 100).toFixed(1) + 'MB';
          if (p >= 100) {
            clearInterval(iv);
            t2.textContent = 'done';
            sz.textContent = '✓';
            setTimeout(() => {
              fill.style.width = '0';
              t2.textContent = 'download';
              sz.textContent = '3.5MB';
              busy = false;
            }, 1400);
          }
        }, 35);
      });
    }
    });
  }

  document.addEventListener('astro:page-load', wireLivePanels);
</script>
