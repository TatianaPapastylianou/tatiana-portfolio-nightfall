---
import Frame from './Frame.astro';

interface Props {
  number: string;
  role: string;
  title: string;
  oneLiner: string;
  slug: string;
  liveUrl?: string;
  preview: string; // /cases/… framed screen
  alt: string;
  tilt?: number;
  index: number;
}
const { number, role, title, oneLiner, slug, liveUrl, preview, alt, tilt = 0 } = Astro.props;
const href = `/work/${slug}`;
---

<article class="case-card reveal">
  <div class="case-frame">
    <Frame src={preview} alt={alt} size="md" tilt={tilt} href={href} label="View case →" view />
  </div>

  <div class="case-plaque">
    <p class="kicker"><span class="num">{number}</span> · {role}</p>
    <h3 class="case-title"><a href={href}>{title}</a></h3>
    <p class="case-line">{oneLiner}</p>
    <div class="case-meta">
      <a class="textlink case-read" href={href}>Read the case <span aria-hidden="true">→</span></a>
      {
        liveUrl && (
          <a class="case-live" href={liveUrl} target="_blank" rel="noopener">
            Live product ↗
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .case-card {
    display: grid;
    grid-template-columns: minmax(260px, 44%) 1fr;
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: center;
    padding-block: var(--space-xl);
    border-top: 1px solid var(--line);
  }
  .case-card:first-of-type {
    border-top: 0;
  }

  .case-plaque {
    max-width: 46ch;
  }
  .case-title {
    font-size: var(--step-3);
    margin-top: 0.5rem;
    line-height: 1.05;
  }
  .case-title a {
    color: var(--head);
    background-image: linear-gradient(var(--ink), var(--ink));
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.4s var(--ease-out);
  }
  .case-title a:hover {
    background-size: 100% 1px;
  }
  .case-line {
    margin-top: var(--space-s);
    color: var(--body);
    font-size: var(--step-0);
    line-height: 1.55;
  }
  .case-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.8rem;
    align-items: center;
    margin-top: var(--space-m);
  }
  .case-read {
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .case-read span {
    display: inline-block;
    transition: transform 0.3s var(--ease-out);
  }
  .case-read:hover span {
    transform: translateX(5px);
  }
  .case-live {
    font-size: var(--step--1);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--gold-deep);
    border-bottom: 1px solid transparent;
  }
  .case-live:hover {
    border-bottom-color: var(--gold-deep);
  }

  @media (max-width: 820px) {
    .case-card {
      grid-template-columns: 1fr;
      gap: var(--space-m);
    }
  }
</style>
