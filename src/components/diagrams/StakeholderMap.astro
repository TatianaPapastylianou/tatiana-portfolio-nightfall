---
// Case 02 — the three-authority tension map. Three executives who could each
// overrule the others pull toward different products; the learner sits at the
// centre as the stakeholder not in the meeting. Ink line-work; gold for the
// learner only. Theme-aware via the design tokens.
---

<svg
  class="dgm"
  viewBox="0 0 760 450"
  role="img"
  aria-label="A tension map: the founder pulls toward austerity, the board toward structured clarity, the math editors toward richness — and the learner sits at the centre as the stakeholder not in the meeting."
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- tension: dashed triangle between the three authorities -->
  <g class="dgm-tension">
    <line x1="380" y1="92" x2="150" y2="352" />
    <line x1="380" y1="92" x2="610" y2="352" />
    <line x1="150" y1="352" x2="610" y2="352" />
  </g>

  <!-- pull: each authority pulls on the learner -->
  <g class="dgm-pull">
    <line x1="380" y1="112" x2="380" y2="150" />
    <line x1="250" y1="330" x2="332" y2="252" />
    <line x1="510" y1="330" x2="428" y2="252" />
  </g>

  <!-- the learner at the centre -->
  <circle class="dgm-learner" cx="380" cy="210" r="62"></circle>
  <text class="dgm-learner-t" x="380" y="204" text-anchor="middle">THE LEARNER</text>
  <text class="dgm-learner-s" x="380" y="224" text-anchor="middle">not in the meeting</text>

  <!-- authority nodes -->
  <g class="dgm-node">
    <rect x="248" y="22" width="264" height="74" rx="10"></rect>
    <text class="dgm-node-t" x="380" y="52" text-anchor="middle">THE FOUNDER</text>
    <text class="dgm-node-s" x="380" y="74" text-anchor="middle">austerity — no text, no colour,</text>
    <text class="dgm-node-s" x="380" y="88" text-anchor="middle">search-first</text>
  </g>
  <g class="dgm-node">
    <rect x="24" y="352" width="252" height="74" rx="10"></rect>
    <text class="dgm-node-t" x="150" y="382" text-anchor="middle">THE BOARD</text>
    <text class="dgm-node-s" x="150" y="404" text-anchor="middle">structured clarity,</text>
    <text class="dgm-node-s" x="150" y="418" text-anchor="middle">everything legible on screen</text>
  </g>
  <g class="dgm-node">
    <rect x="484" y="352" width="252" height="74" rx="10"></rect>
    <text class="dgm-node-t" x="610" y="382" text-anchor="middle">THE MATH EDITORS</text>
    <text class="dgm-node-s" x="610" y="404" text-anchor="middle">more assets, colour,</text>
    <text class="dgm-node-s" x="610" y="418" text-anchor="middle">interactivity</text>
  </g>
</svg>

<style>
  .dgm {
    width: 100%;
    max-width: 680px;
    height: auto;
    margin-inline: auto;
    display: block;
  }
  .dgm-tension line {
    stroke: var(--line-strong);
    stroke-width: 1.4;
    stroke-dasharray: 5 6;
  }
  .dgm-pull line {
    stroke: var(--ink);
    stroke-width: 1.8;
  }
  .dgm-node rect {
    fill: var(--card);
    stroke: var(--ink);
    stroke-width: 1.4;
  }
  .dgm-node-t {
    fill: var(--head);
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
  }
  .dgm-node-s {
    fill: var(--body);
    font-family: var(--sans);
    font-size: 11.5px;
  }
  .dgm-learner {
    fill: var(--gold-lite);
    stroke: var(--gold-deep);
    stroke-width: 1.8;
  }
  .dgm-learner-t {
    fill: var(--head);
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
  }
  .dgm-learner-s {
    fill: #5c4a1e;
    font-family: var(--sans);
    font-size: 11.5px;
    font-style: italic;
  }
</style>
