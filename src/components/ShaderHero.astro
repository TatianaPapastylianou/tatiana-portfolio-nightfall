---
// Home hero: painterly animated haze behind the name plate.
// Layer order (back → front):
//   1. CSS gradient (always visible — the reduced-motion / no-WebGL fallback)
//   2. <canvas> shader (enhancement only)
//   3. luminous "heroine" glow (CSS)
//   4. text content
---

<section class="hero" data-parallax-scope>
  <div class="hero-bg" aria-hidden="true">
    <canvas class="hero-canvas" data-hero-canvas></canvas>
    <div class="hero-figure" data-parallax="0.06"></div>
    <div class="hero-vignette"></div>
  </div>

  <div class="container hero-content">
    <p class="eyebrow reveal">Senior Product Designer · Systems &amp; shipped products</p>
    <h1 class="hero-title reveal">Tatiana<br /><span class="hero-title-2">Papastylianou</span></h1>
    <p class="hero-tagline reveal">
      Systems, shipped products, and a taste for dark, dreaming interfaces. I turn
      contradictory briefs into products people can actually use — and the design systems that
      hold them together.
    </p>
    <div class="hero-cta reveal">
      <a class="btn btn--solid" href="/work/design-system">View the work</a>
      <a class="btn" href="/about">The person behind it</a>
    </div>
  </div>

  <div class="hero-scroll reveal" aria-hidden="true">
    <span>Scroll</span>
    <span class="hero-scroll-line"></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(92svh, 900px);
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    /* fallback gradient — the "candlelight over dark water" mood without JS */
    background:
      radial-gradient(60% 55% at 28% 40%, rgba(230, 200, 120, 0.22), transparent 68%),
      radial-gradient(70% 60% at 78% 72%, rgba(46, 110, 126, 0.34), transparent 70%),
      radial-gradient(90% 80% at 50% 120%, rgba(176, 106, 120, 0.12), transparent 70%),
      linear-gradient(160deg, #0b0e13 0%, #12192a 55%, #0e1116 100%);
  }

  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s ease;
    mix-blend-mode: screen;
  }

  .hero-canvas.is-ready {
    opacity: 0.9;
  }

  /* luminous heroine — light & gradient only, per art direction */
  .hero-figure {
    position: absolute;
    left: 22%;
    top: 34%;
    width: clamp(120px, 18vw, 260px);
    height: clamp(200px, 30vw, 440px);
    border-radius: 42% 42% 46% 46% / 56% 56% 44% 44%;
    background:
      radial-gradient(50% 40% at 50% 22%, rgba(255, 240, 205, 0.55), transparent 70%),
      linear-gradient(180deg, rgba(230, 200, 120, 0.5), rgba(176, 106, 120, 0.16) 70%, transparent);
    filter: blur(14px);
    opacity: 0.75;
  }

  .hero-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 100% at 50% 40%, transparent 45%, rgba(8, 10, 14, 0.72) 100%);
  }

  .hero-content {
    position: relative;
    padding-block: var(--space-2xl);
  }

  .hero-title {
    font-size: var(--step-5);
    line-height: 0.94;
    margin-top: 0.35em;
    color: var(--parchment);
    letter-spacing: -0.01em;
    text-shadow: 0 2px 40px rgba(8, 10, 14, 0.6);
  }

  .hero-title-2 {
    color: var(--gold-lite);
    font-style: italic;
  }

  .hero-tagline {
    max-width: 44ch;
    margin-top: var(--space-m);
    font-size: var(--step-1);
    color: var(--text);
    line-height: 1.5;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: var(--space-l);
  }

  .hero-scroll {
    position: absolute;
    left: 50%;
    bottom: 1.6rem;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .hero-scroll-line {
    width: 1px;
    height: 46px;
    background: linear-gradient(var(--gold), transparent);
    animation: scrollpulse 2.4s var(--ease-in-out) infinite;
  }

  @keyframes scrollpulse {
    0%,
    100% {
      transform: scaleY(0.4);
      opacity: 0.4;
      transform-origin: top;
    }
    50% {
      transform: scaleY(1);
      opacity: 1;
      transform-origin: top;
    }
  }

  @media (max-width: 640px) {
    .hero-figure {
      left: 8%;
      opacity: 0.55;
    }
    .hero {
      min-height: 88svh;
    }
  }
</style>

<script>
  // Painterly candlelight-over-water shader. Enhancement only:
  // if reduced-motion, no WebGL, or a tiny screen, we leave the CSS gradient showing.
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');

  if (canvas && !prefersReduced) {
    const gl = canvas.getContext('webgl', { antialias: false, alpha: true });

    if (gl) {
      const vert = `
        attribute vec2 p;
        void main(){ gl_Position = vec4(p, 0.0, 1.0); }
      `;
      // Flowing value-noise haze in gold + deep aqua, drifting like candlelight on dark water.
      const frag = `
        precision mediump float;
        uniform vec2 u_res;
        uniform float u_time;

        float hash(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
        float noise(vec2 p){
          vec2 i = floor(p); vec2 f = fract(p);
          vec2 u = f*f*(3.0-2.0*f);
          return mix(mix(hash(i), hash(i+vec2(1.0,0.0)), u.x),
                     mix(hash(i+vec2(0.0,1.0)), hash(i+vec2(1.0,1.0)), u.x), u.y);
        }
        float fbm(vec2 p){
          float v = 0.0; float a = 0.5;
          for(int i=0;i<5;i++){ v += a*noise(p); p *= 2.0; a *= 0.5; }
          return v;
        }
        void main(){
          vec2 uv = gl_FragCoord.xy / u_res.xy;
          vec2 asp = vec2(u_res.x/u_res.y, 1.0);
          vec2 p = uv * asp * 2.4;
          float t = u_time * 0.06;

          float n = fbm(p + vec2(t, -t*0.6) + fbm(p*0.6 - t));
          float haze = fbm(p*1.7 + vec2(-t*0.5, t));

          vec3 night = vec3(0.043, 0.06, 0.09);
          vec3 aqua  = vec3(0.18, 0.43, 0.49);
          vec3 gold  = vec3(0.90, 0.78, 0.47);

          // candle pool lower-left, aqua depth toward lower-right
          float candle = smoothstep(0.75, 0.0, distance(uv, vec2(0.30, 0.44)));
          float water  = smoothstep(0.9, 0.05, distance(uv, vec2(0.78, 0.72)));

          vec3 col = night;
          col = mix(col, aqua, water * (0.35 + 0.4*haze));
          col = mix(col, gold, candle * (0.25 + 0.55*n));
          col += gold * pow(n, 3.0) * candle * 0.5;

          float vig = smoothstep(1.15, 0.35, distance(uv, vec2(0.5)));
          col *= vig;

          gl_FragColor = vec4(col, 0.92);
        }
      `;

      const compile = (type: number, src: string) => {
        const s = gl.createShader(type)!;
        gl.shaderSource(s, src);
        gl.compileShader(s);
        return s;
      };

      const prog = gl.createProgram()!;
      gl.attachShader(prog, compile(gl.VERTEX_SHADER, vert));
      gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, frag));
      gl.linkProgram(prog);
      gl.useProgram(prog);

      const buf = gl.createBuffer();
      gl.bindBuffer(gl.ARRAY_BUFFER, buf);
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
      const loc = gl.getAttribLocation(prog, 'p');
      gl.enableVertexAttribArray(loc);
      gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

      const uRes = gl.getUniformLocation(prog, 'u_res');
      const uTime = gl.getUniformLocation(prog, 'u_time');

      // cap resolution for performance — the haze is soft, it doesn't need pixels
      const DPR = Math.min(window.devicePixelRatio || 1, 1.5);
      const resize = () => {
        const w = Math.floor(canvas.clientWidth * DPR);
        const h = Math.floor(canvas.clientHeight * DPR);
        if (canvas.width !== w || canvas.height !== h) {
          canvas.width = w;
          canvas.height = h;
          gl.viewport(0, 0, w, h);
        }
      };

      let running = true;
      const start = performance.now();
      const render = (now: number) => {
        if (!running) return;
        resize();
        gl.uniform2f(uRes, canvas.width, canvas.height);
        gl.uniform1f(uTime, (now - start) / 1000);
        gl.drawArrays(gl.TRIANGLES, 0, 3);
        requestAnimationFrame(render);
      };

      canvas.classList.add('is-ready');
      requestAnimationFrame(render);

      // pause when the hero scrolls away or the tab is hidden — saves battery
      const io = new IntersectionObserver(
        ([e]) => {
          running = e.isIntersecting && !document.hidden;
          if (running) requestAnimationFrame(render);
        },
        { threshold: 0.02 }
      );
      io.observe(canvas);
      document.addEventListener('visibilitychange', () => {
        running = !document.hidden;
        if (running) requestAnimationFrame(render);
      });
    }
  }
</script>
