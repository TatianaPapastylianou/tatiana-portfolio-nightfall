---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Frame from '../../components/Frame.astro';
import LiveComponents from '../../components/LiveComponents.astro';
import CaseThinking from '../../components/CaseThinking.astro';
import CaseSpotlight from '../../components/CaseSpotlight.astro';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  return cases.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

// inline each drawing's SVG at build time (one source file serves both the inline
// figure and the framed <img> used elsewhere)
const drawings = d.drawings.map((dr) => ({
  ...dr,
  svg: fs.readFileSync(path.join(process.cwd(), 'public', dr.src), 'utf8'),
}));

// section index: only the layers this case actually has
const sections = [
  { id: 'overview', label: 'Overview' },
  ...(d.drawings.length ? [{ id: 'maps', label: 'Maps and flows' }] : []),
  ...(d.exhibits.length ? [{ id: 'screens', label: 'Screens' }] : []),
  ...(d.spotlight ? [{ id: 'zoom', label: 'Zoom in' }] : []),
  ...(d.process ? [{ id: 'reasoning', label: 'Reasoning' }] : []),
  { id: 'details', label: 'Details' },
];

// reading time: the prose body plus the visible reasoning layer, at 230 words a minute
const countWords = (t: string) => (t.match(/[\p{L}\p{N}]+/gu) ?? []).length;
const layerText = JSON.stringify([d.process ?? {}, d.spotlight ?? {}, d.exhibits.map((e) => e.caption), d.drawings.map((x) => x.caption)]);
const readMin = Math.max(2, Math.round((countWords(entry.body ?? '') + countWords(layerText)) / 230));
---

<Base title={`${d.number} · ${d.title} — Tatiana Papastylianou`} description={d.oneLiner}>
  <div class="read-progress" aria-hidden="true"><span></span></div>

  <nav class="case-index" aria-label="Sections in this case">
    <ol>
      {sections.map((sec, i) => (
        <li><a href={`#${sec.id}`} data-sec={sec.id}><span class="ci-n">{String(i + 1).padStart(2, '0')}</span>{sec.label}</a></li>
      ))}
    </ol>
  </nav>

  <!-- case hero -->
  <header class="case-hero" id="overview">
    <div class="container case-hero-inner">
      <p class="kicker reveal">
        <a href="/#work" class="back-link">Work</a>
        <span aria-hidden="true"> · </span><span class="num">{d.number}</span> · {d.role}
      </p>
      <h1 class="case-h1 reveal">{d.title}</h1>
      <p class="case-change reveal">
        <span class="change-from">{d.change}</span>
        <span class="change-arrow" aria-hidden="true">→</span>
        <span class="change-to">{d.impact}</span>
      </p>
      <p class="case-oneliner reveal">{d.oneLiner}</p>
      {!d.glance && <p class="case-role reveal">{d.roleFull}</p>}
      <p class="case-meta reveal">
        <span class="case-read">{readMin} min read</span>
      </p>
      {
        d.glance && (
          <dl class="glance reveal">
            {d.glance.map((g) => (
              <div class="glance-item">
                <dt>{g.k}</dt>
                <dd>{g.v}</dd>
              </div>
            ))}
          </dl>
        )
      }
      {
        d.liveUrl && (
          <p class="reveal case-cta-row">
            <a class="btn btn--solid" href={d.liveUrl} target="_blank" rel="noopener">
              Visit the live product ↗
            </a>
          </p>
        )
      }
    </div>
  </header>

  <!-- framed hero: the HR "wow" -->
  <section class="exhibit exhibit--hero" aria-label="Hero exhibit">
    <div class="container exhibit-inner">
      <div class="exhibit-frame reveal">
        {
          d.hero.kind === 'live' ? (
            <Frame size="lg" tilt={-0.6} mat={false} live eager>
              <LiveComponents />
            </Frame>
          ) : (
            <Frame
              src={d.hero.src}
              alt={d.hero.alt}
              orient={d.hero.orient ?? 'portrait'}
              fit={d.hero.fit}
              size="lg"
              tilt={-0.6}
              eager
            />
          )
        }
      </div>
      <p class="exhibit-caption reveal hero-caption">{d.hero.caption}</p>
    </div>
  </section>

  <!-- full-width drawings: maps and flows -->
  {
    drawings.length > 0 && (
      <section class="drawings" id="maps" aria-label="Maps and flows">
        <div class="container">
          {drawings.map((dr) => (
            <figure class="drawing">
              <figcaption class="drawing-note reveal">
                <p class="kicker">{dr.kicker}</p>
                <p class="drawing-caption">{dr.caption}</p>
              </figcaption>
              <div
                class="drawing-sheet reveal"
                role="button"
                tabindex="0"
                data-zoom-src={dr.src}
                data-zoom-alt={dr.kicker}
                data-view
                data-label="Zoom in ⤢"
                aria-label={`View full screen: ${dr.kicker}`}
              >
                <div class="drawing-scroll" set:html={dr.svg} />
              </div>
              <p class="drawing-hint">Swipe to see the whole drawing, or tap to open it full screen.</p>
            </figure>
          ))}
        </div>
      </section>
    )
  }

  <!-- curated depth exhibits -->
  {
    d.exhibits.length > 0 && (
      <section class="exhibits" id="screens" aria-label="Selected exhibits">
        <div class="container">
          {d.exhibits.map((ex, i) => (
            <figure class:list={['exhibit-row', { alt: i % 2 === 1 }]}>
              <div class="exhibit-frame reveal">
                <Frame
                  src={ex.src}
                  alt={ex.alt}
                  orient={ex.orient ?? 'portrait'}
                  fit={ex.fit}
                  size={ex.size ?? 'md'}
                  tilt={ex.tilt ?? 0}
                />
              </div>
              <figcaption class="exhibit-note reveal">
                {ex.status && (
                  <span class:list={['exhibit-status', `exhibit-status--${ex.status}`]}>
                    {ex.status === 'shipped' ? 'Shipped' : 'Explored'}
                  </span>
                )}
                <p class="kicker">{ex.kicker}</p>
                <p class="exhibit-caption">{ex.caption}</p>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )
  }

  <!-- optional zoom-in on one piece of craft -->
  {d.spotlight && <div id="zoom" class="anchor"><CaseSpotlight spotlight={d.spotlight} /></div>}

  <!-- the visible reasoning layer -->
  {d.process && <div id="reasoning" class="anchor"><CaseThinking process={d.process} /></div>}

  <!-- the readable placard: the deep read -->
  <div class="placard-wrap" id="details">
    <div class="container">
      <p class="kicker placard-kicker reveal">The details</p>
      <article class="placard reveal">
        <Content />
      </article>
    </div>
  </div>

  <!-- next case -->
  <nav class="next-case" aria-label="Next case">
    <a href={`/work/${d.next.slug}`} class="container next-inner" data-view data-label="View case →">
      <span class="kicker">Next</span>
      <span class="next-title">{d.next.title}</span>
      <span class="next-arrow" aria-hidden="true">→</span>
    </a>
  </nav>
</Base>

<script>
  const bar = document.querySelector<HTMLElement>('.read-progress span');
  if (bar) {
    const update = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      bar.style.transform = `scaleX(${max > 0 ? Math.min(1, window.scrollY / max) : 0})`;
    };
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }

  // index clicks go through Lenis when smooth scroll is on, so the jump isn't swallowed
  document.querySelectorAll<HTMLAnchorElement>('.case-index a').forEach((a) => {
    a.addEventListener('click', (ev) => {
      const target = document.getElementById(a.dataset.sec ?? '');
      const lenis = (window as unknown as { __lenis?: { scrollTo: (t: number, o?: Record<string, unknown>) => void } }).__lenis;
      if (!target) return;
      ev.preventDefault();
      // pixel targets: images above may finish loading mid-scroll and push the
      // section down, so land once, then re-measure and correct until it holds
      const y = () => Math.round(target.getBoundingClientRect().top + window.scrollY - 80);
      const go = (immediate: boolean) =>
        lenis ? lenis.scrollTo(y(), { immediate }) : window.scrollTo({ top: y(), behavior: immediate ? 'auto' : 'smooth' });
      go(false);
      let tries = 0;
      const settle = () => {
        if (Math.abs(target.getBoundingClientRect().top - 80) > 4) go(true);
        if (++tries < 10) setTimeout(settle, 250);
      };
      setTimeout(settle, 1100);
      history.replaceState(null, '', `#${target.id}`);
    });
  });

  // highlight the section in view in the index
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.case-index a')];
  if (links.length && 'IntersectionObserver' in window) {
    const byId = new Map(links.map((a) => [a.dataset.sec, a]));
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          links.forEach((a) => a.removeAttribute('aria-current'));
          byId.get(e.target.id)?.setAttribute('aria-current', 'true');
        });
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    byId.forEach((_, id) => {
      const el = id && document.getElementById(id);
      if (el) io.observe(el);
    });
  }
</script>

<style>
  html {
    scroll-padding-top: 5rem;
  }
  .anchor {
    display: block;
  }
  .glance {
    margin: var(--space-m) 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .glance-item {
    padding: 0.85rem 1rem 0.9rem 0;
  }
  .glance-item + .glance-item {
    padding-left: 1rem;
    border-left: 1px solid var(--line);
  }
  .glance dt {
    font-family: var(--sans);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .glance dd {
    margin: 0.3rem 0 0;
    font-family: var(--sans);
    font-size: var(--step--1);
    line-height: 1.4;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 640px) {
    .glance {
      grid-template-columns: 1fr 1fr;
    }
    .glance-item,
    .glance-item + .glance-item {
      padding: 0.75rem 0.75rem 0.75rem 0;
      border-left: 0;
    }
  }
  .case-index {
    display: none;
  }
  @media (min-width: 1360px) {
    .case-index {
      display: block;
      position: fixed;
      left: 1.5rem;
      top: 50%;
      transform: translateY(-50%);
      z-index: 40;
    }
    .case-index ol {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 0.55rem;
    }
    .case-index a {
      display: flex;
      gap: 0.5rem;
      align-items: baseline;
      font-family: var(--sans);
      font-size: 0.72rem;
      letter-spacing: 0.04em;
      color: var(--dim);
      text-decoration: none;
      opacity: 0.7;
      transition: opacity 0.2s ease, color 0.2s ease;
    }
    .case-index a:hover,
    .case-index a:focus-visible,
    .case-index a[aria-current='true'] {
      opacity: 1;
      color: var(--ink);
    }
    .case-index a[aria-current='true'] {
      font-weight: 600;
    }
    .ci-n {
      font-variant-numeric: tabular-nums;
      font-size: 0.64rem;
    }
  }
  .read-progress {
    position: fixed;
    inset: 0 0 auto 0;
    height: 2px;
    z-index: 60;
    pointer-events: none;
  }
  .read-progress span {
    display: block;
    height: 100%;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }
  .case-hero {
    padding-block: var(--space-2xl) var(--space-l);
  }
  .case-meta {
    margin-top: var(--space-s);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    align-items: baseline;
    font-family: var(--sans);
    font-size: var(--step--1);
    color: var(--dim);
  }
  .case-read {
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.68rem;
    color: var(--head);
  }
  .case-nda {
    max-width: 52ch;
  }
  .case-hero-inner {
    max-width: 62ch;
  }
  .back-link {
    color: var(--dim);
    border-bottom: 1px solid transparent;
  }
  .back-link:hover {
    color: var(--head);
    border-bottom-color: var(--ink);
  }
  .case-h1 {
    font-size: var(--step-4);
    margin-top: 0.7rem;
    max-width: 18ch;
  }
  .case-change {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
    margin-top: var(--space-m);
    font-family: var(--serif);
    font-size: var(--step-1);
  }
  .change-from {
    color: var(--dim);
  }
  .change-arrow {
    color: var(--gold-deep);
  }
  .change-to {
    color: var(--head);
    font-style: italic;
  }
  .case-oneliner {
    max-width: 54ch;
    margin-top: var(--space-m);
    font-size: var(--step-1);
    color: var(--body);
    line-height: 1.5;
  }
  .case-role {
    margin-top: var(--space-s);
    font-family: var(--sans);
    font-size: var(--step--1);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .case-cta-row {
    margin-top: var(--space-l);
  }

  /* framed hero */
  .exhibit--hero {
    padding-block: var(--space-l) var(--space-xl);
  }
  .exhibit-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) 0.8fr;
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: center;
  }
  .hero-caption {
    max-width: 40ch;
  }

  /* drawings: full-width maps and flows on a card sheet */
  .drawings {
    padding-bottom: var(--space-xl);
  }
  .drawing {
    margin: 0;
    padding-block: var(--space-l);
    border-top: 1px solid var(--line);
  }
  .drawing-note {
    max-width: 60ch;
    margin-bottom: var(--space-m);
  }
  .drawing-note .kicker {
    color: var(--gold-deep);
  }
  .drawing-caption {
    margin-top: 0.6rem;
    font-size: var(--step-0);
    color: var(--body);
    line-height: 1.55;
  }
  .drawing-sheet {
    background: var(--card);
    border-radius: var(--radius);
    box-shadow:
      0 24px 60px rgba(60, 44, 24, 0.12),
      inset 0 0 0 1px var(--line);
    padding: clamp(1rem, 3vw, 2.5rem);
    cursor: zoom-in;
  }
  .drawing-sheet:focus-visible {
    outline: 2px solid var(--gold-deep);
    outline-offset: 6px;
  }
  .drawing-scroll :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  /* the drawing's own corner label repeats the kicker above it; keep it for framed use only */
  .drawing-scroll :global(.re-label) {
    display: none;
  }
  .drawing-hint {
    display: none;
    margin-top: 0.6rem;
    font-family: var(--sans);
    font-size: var(--step--1);
    color: var(--dim);
  }
  @media (max-width: 760px) {
    .drawing-scroll {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
    .drawing-scroll :global(svg) {
      width: 860px;
      max-width: none;
    }
    .drawing-hint {
      display: block;
    }
  }

  /* exhibits */
  .exhibits {
    padding-bottom: var(--space-2xl);
  }
  .exhibit-row {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) 0.85fr;
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: center;
    margin: 0;
    padding-block: var(--space-l);
    border-top: 1px solid var(--line);
  }
  .exhibit-row.alt {
    direction: rtl;
  }
  .exhibit-row.alt > * {
    direction: ltr;
  }
  .exhibit-note {
    max-width: 42ch;
  }
  /* honesty tag — a small museum-style placard status above the kicker */
  .exhibit-status {
    display: inline-block;
    margin-bottom: 0.7rem;
    padding: 0.28em 0.7em;
    border-radius: 100px;
    font-family: var(--sans);
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border: 1px solid var(--line);
  }
  .exhibit-status--shipped {
    color: var(--head);
    background: var(--paper-2);
    border-color: var(--gold-deep);
  }
  .exhibit-status--explored {
    color: var(--dim);
    background: transparent;
    border-style: dashed;
  }
  .exhibit-note .kicker {
    color: var(--gold-deep);
  }
  .exhibit-caption {
    margin-top: 0.7rem;
    font-size: var(--step-0);
    color: var(--body);
    line-height: 1.55;
  }

  /* placard: the readable narrative on a card */
  .placard-wrap {
    background: var(--paper-2);
    border-block: 1px solid var(--line);
    padding-block: var(--space-2xl);
  }
  .placard-kicker {
    margin-bottom: var(--space-m);
    text-align: center;
  }
  .placard {
    max-width: var(--container-narrow);
    margin-inline: auto;
    background: var(--card);
    color: var(--body);
    padding: clamp(1.75rem, 5vw, 4.5rem);
    border-radius: var(--radius);
    box-shadow:
      0 30px 70px rgba(60, 44, 24, 0.14),
      inset 0 0 0 1px var(--line);
    font-size: var(--step-0);
    line-height: 1.72;
  }

  @media (max-width: 820px) {
    .exhibit-inner,
    .exhibit-row {
      grid-template-columns: 1fr;
    }
    .exhibit-row.alt {
      direction: ltr;
    }
  }

  /* next-case bar */
  .next-case {
    border-top: 1px solid var(--line);
  }
  .next-inner {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    padding-block: var(--space-xl);
    color: var(--head);
  }
  .next-title {
    font-family: var(--serif);
    font-size: var(--step-2);
    color: var(--head);
    transition: opacity 0.3s var(--ease-out);
  }
  .next-arrow {
    margin-left: auto;
    font-size: var(--step-2);
    color: var(--gold-deep);
    transition: transform 0.3s var(--ease-out);
  }
  .next-inner:hover .next-title {
    opacity: 0.62;
  }
  .next-inner:hover .next-arrow {
    transform: translateX(8px);
  }
  @media (max-width: 640px) {
    .next-inner {
      flex-wrap: wrap;
      gap: 0.6rem;
    }
    .next-arrow {
      margin-left: 0;
    }
  }
</style>

<!-- placard prose styling (light museum placard) -->
<style is:global>
  .placard > :first-child {
    margin-top: 0;
  }
  .placard h2 {
    font-family: var(--serif);
    font-size: var(--step-3);
    color: var(--head);
    line-height: 1.1;
    margin-top: 2.4em;
    padding-bottom: 0.35em;
    border-bottom: 1px solid var(--line-strong);
  }
  .placard h3 {
    font-family: var(--serif);
    font-size: var(--step-1);
    color: var(--head);
    margin-top: 2em;
  }
  .placard p,
  .placard li {
    color: var(--body);
  }
  .placard p {
    margin-top: 1.1em;
    max-width: 66ch;
  }
  .placard ul {
    margin-top: 1.1em;
    padding-left: 1.3em;
    display: grid;
    gap: 0.6em;
  }
  .placard li {
    padding-left: 0.25em;
  }
  .placard li::marker {
    color: var(--gold-deep);
  }
  .placard strong {
    color: var(--head);
    font-weight: 600;
  }
  .placard em {
    color: var(--ink);
  }
  .placard a {
    color: var(--ink);
    border-bottom: 1px solid var(--ink);
    font-weight: 500;
  }
  .placard a:hover {
    opacity: 0.62;
  }
  .placard code {
    font-family: var(--mono);
    font-size: 0.9em;
    background: rgba(33, 25, 19, 0.08);
    padding: 0.12em 0.4em;
    border-radius: 4px;
    color: var(--ink);
  }
  .placard table {
    width: 100%;
    margin-top: 1.6em;
    border-collapse: collapse;
    font-size: 0.95em;
  }
  .placard table td {
    padding: 0.7em 1em;
    border-top: 1px solid var(--line);
    vertical-align: top;
  }
  .placard table td:first-child {
    width: 34%;
    color: var(--ink);
    font-weight: 500;
  }
  .placard table tr:first-child td {
    border-top: 0;
  }
  .placard blockquote {
    margin: 1.6em 0;
    padding: 0.4em 0 0.4em 1.4em;
    border-left: 3px solid var(--gold-deep);
    font-family: var(--serif);
    font-size: var(--step-1);
    font-style: italic;
    color: var(--head);
  }
  @media (max-width: 560px) {
    .placard table td:first-child {
      width: 42%;
    }
  }
</style>
