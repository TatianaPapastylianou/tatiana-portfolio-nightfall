---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Frame from '../../components/Frame.astro';
import LiveComponents from '../../components/LiveComponents.astro';

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  return cases.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<Base title={`${d.number} · ${d.title} — Tatiana Papastylianou`} description={d.oneLiner}>
  <!-- case hero -->
  <header class="case-hero">
    <div class="container case-hero-inner">
      <p class="kicker reveal">
        <a href="/#work" class="back-link">Work</a>
        <span aria-hidden="true"> · </span><span class="num">{d.number}</span> · {d.role}
      </p>
      <h1 class="case-h1 reveal">{d.title}</h1>
      <p class="case-change reveal">
        <span class="change-from">{d.change}</span>
        <span class="change-arrow" aria-hidden="true">→</span>
        <span class="change-to">{d.impact}</span>
      </p>
      <p class="case-oneliner reveal">{d.oneLiner}</p>
      <p class="case-role reveal">{d.roleFull}</p>
      {
        d.liveUrl && (
          <p class="reveal case-cta-row">
            <a class="btn btn--solid" href={d.liveUrl} target="_blank" rel="noopener">
              Visit the live product ↗
            </a>
          </p>
        )
      }
    </div>
  </header>

  <!-- framed hero: the HR "wow" -->
  <section class="exhibit exhibit--hero" aria-label="Hero exhibit">
    <div class="container exhibit-inner">
      <div class="exhibit-frame reveal">
        {
          d.hero.kind === 'live' ? (
            <Frame size="lg" tilt={-0.6} mat={false} live>
              <LiveComponents />
            </Frame>
          ) : (
            <Frame
              src={d.hero.src}
              alt={d.hero.alt}
              orient={d.hero.orient ?? 'portrait'}
              fit={d.hero.fit}
              size="lg"
              tilt={-0.6}
            />
          )
        }
      </div>
      <p class="exhibit-caption reveal hero-caption">{d.hero.caption}</p>
    </div>
  </section>

  <!-- curated depth exhibits -->
  {
    d.exhibits.length > 0 && (
      <section class="exhibits" aria-label="Selected exhibits">
        <div class="container">
          {d.exhibits.map((ex, i) => (
            <figure class:list={['exhibit-row', { alt: i % 2 === 1 }]}>
              <div class="exhibit-frame reveal">
                <Frame
                  src={ex.src}
                  alt={ex.alt}
                  orient={ex.orient ?? 'portrait'}
                  fit={ex.fit}
                  size={ex.size ?? 'md'}
                  tilt={ex.tilt ?? 0}
                />
              </div>
              <figcaption class="exhibit-note reveal">
                {ex.status && (
                  <span class:list={['exhibit-status', `exhibit-status--${ex.status}`]}>
                    {ex.status === 'shipped' ? 'Shipped — live' : 'Explored — not shipped'}
                  </span>
                )}
                <p class="kicker">{ex.kicker}</p>
                <p class="exhibit-caption">{ex.caption}</p>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )
  }

  <!-- the readable placard: the deep read -->
  <div class="placard-wrap">
    <div class="container">
      <p class="kicker placard-kicker reveal">The full account</p>
      <article class="placard reveal">
        <Content />
      </article>
    </div>
  </div>

  <!-- next case -->
  <nav class="next-case" aria-label="Next case">
    <a href={`/work/${d.next.slug}`} class="container next-inner" data-view data-label="View case →">
      <span class="kicker">Next in the collection</span>
      <span class="next-title">{d.next.title}</span>
      <span class="next-arrow" aria-hidden="true">→</span>
    </a>
  </nav>
</Base>

<style>
  .case-hero {
    padding-block: var(--space-2xl) var(--space-l);
  }
  .case-hero-inner {
    max-width: 62ch;
  }
  .back-link {
    color: var(--dim);
    border-bottom: 1px solid transparent;
  }
  .back-link:hover {
    color: var(--head);
    border-bottom-color: var(--ink);
  }
  .case-h1 {
    font-size: var(--step-4);
    margin-top: 0.7rem;
    max-width: 18ch;
  }
  .case-change {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
    margin-top: var(--space-m);
    font-family: var(--serif);
    font-size: var(--step-1);
  }
  .change-from {
    color: var(--dim);
  }
  .change-arrow {
    color: var(--gold-deep);
  }
  .change-to {
    color: var(--head);
    font-style: italic;
  }
  .case-oneliner {
    max-width: 54ch;
    margin-top: var(--space-m);
    font-size: var(--step-1);
    color: var(--body);
    line-height: 1.5;
  }
  .case-role {
    margin-top: var(--space-s);
    font-family: var(--sans);
    font-size: var(--step--1);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .case-cta-row {
    margin-top: var(--space-l);
  }

  /* framed hero */
  .exhibit--hero {
    padding-block: var(--space-l) var(--space-xl);
  }
  .exhibit-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) 0.8fr;
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: center;
  }
  .hero-caption {
    max-width: 40ch;
  }

  /* exhibits */
  .exhibits {
    padding-bottom: var(--space-2xl);
  }
  .exhibit-row {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) 0.85fr;
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: center;
    margin: 0;
    padding-block: var(--space-l);
    border-top: 1px solid var(--line);
  }
  .exhibit-row.alt {
    direction: rtl;
  }
  .exhibit-row.alt > * {
    direction: ltr;
  }
  .exhibit-note {
    max-width: 42ch;
  }
  /* honesty tag — a small museum-style placard status above the kicker */
  .exhibit-status {
    display: inline-block;
    margin-bottom: 0.7rem;
    padding: 0.28em 0.7em;
    border-radius: 100px;
    font-family: var(--sans);
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border: 1px solid var(--line);
  }
  .exhibit-status--shipped {
    color: var(--head);
    background: var(--paper-2);
    border-color: var(--gold-deep);
  }
  .exhibit-status--explored {
    color: var(--dim);
    background: transparent;
    border-style: dashed;
  }
  .exhibit-note .kicker {
    color: var(--gold-deep);
  }
  .exhibit-caption {
    margin-top: 0.7rem;
    font-size: var(--step-0);
    color: var(--body);
    line-height: 1.55;
  }

  /* placard: the readable narrative on a card */
  .placard-wrap {
    background: var(--paper-2);
    border-block: 1px solid var(--line);
    padding-block: var(--space-2xl);
  }
  .placard-kicker {
    margin-bottom: var(--space-m);
    text-align: center;
  }
  .placard {
    max-width: var(--container-narrow);
    margin-inline: auto;
    background: var(--card);
    color: var(--body);
    padding: clamp(1.75rem, 5vw, 4.5rem);
    border-radius: var(--radius);
    box-shadow:
      0 30px 70px rgba(60, 44, 24, 0.14),
      inset 0 0 0 1px var(--line);
    font-size: var(--step-0);
    line-height: 1.72;
  }

  @media (max-width: 820px) {
    .exhibit-inner,
    .exhibit-row {
      grid-template-columns: 1fr;
    }
    .exhibit-row.alt {
      direction: ltr;
    }
  }

  /* next-case bar */
  .next-case {
    border-top: 1px solid var(--line);
  }
  .next-inner {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    padding-block: var(--space-xl);
    color: var(--head);
  }
  .next-title {
    font-family: var(--serif);
    font-size: var(--step-2);
    color: var(--head);
    transition: opacity 0.3s var(--ease-out);
  }
  .next-arrow {
    margin-left: auto;
    font-size: var(--step-2);
    color: var(--gold-deep);
    transition: transform 0.3s var(--ease-out);
  }
  .next-inner:hover .next-title {
    opacity: 0.62;
  }
  .next-inner:hover .next-arrow {
    transform: translateX(8px);
  }
  @media (max-width: 640px) {
    .next-inner {
      flex-wrap: wrap;
      gap: 0.6rem;
    }
    .next-arrow {
      margin-left: 0;
    }
  }
</style>

<!-- placard prose styling (light museum placard) -->
<style is:global>
  .placard > :first-child {
    margin-top: 0;
  }
  .placard h2 {
    font-family: var(--serif);
    font-size: var(--step-3);
    color: var(--head);
    line-height: 1.1;
    margin-top: 2.4em;
    padding-bottom: 0.35em;
    border-bottom: 1px solid var(--line-strong);
  }
  .placard h3 {
    font-family: var(--serif);
    font-size: var(--step-1);
    color: var(--head);
    margin-top: 2em;
  }
  .placard p,
  .placard li {
    color: var(--body);
  }
  .placard p {
    margin-top: 1.1em;
    max-width: 66ch;
  }
  .placard ul {
    margin-top: 1.1em;
    padding-left: 1.3em;
    display: grid;
    gap: 0.6em;
  }
  .placard li {
    padding-left: 0.25em;
  }
  .placard li::marker {
    color: var(--gold-deep);
  }
  .placard strong {
    color: var(--head);
    font-weight: 600;
  }
  .placard em {
    color: var(--ink);
  }
  .placard a {
    color: var(--ink);
    border-bottom: 1px solid var(--ink);
    font-weight: 500;
  }
  .placard a:hover {
    opacity: 0.62;
  }
  .placard code {
    font-family: var(--mono);
    font-size: 0.9em;
    background: rgba(33, 25, 19, 0.08);
    padding: 0.12em 0.4em;
    border-radius: 4px;
    color: var(--ink);
  }
  .placard table {
    width: 100%;
    margin-top: 1.6em;
    border-collapse: collapse;
    font-size: 0.95em;
  }
  .placard table td {
    padding: 0.7em 1em;
    border-top: 1px solid var(--line);
    vertical-align: top;
  }
  .placard table td:first-child {
    width: 34%;
    color: var(--ink);
    font-weight: 500;
  }
  .placard table tr:first-child td {
    border-top: 0;
  }
  .placard blockquote {
    margin: 1.6em 0;
    padding: 0.4em 0 0.4em 1.4em;
    border-left: 3px solid var(--gold-deep);
    font-family: var(--serif);
    font-size: var(--step-1);
    font-style: italic;
    color: var(--head);
  }
  @media (max-width: 560px) {
    .placard table td:first-child {
      width: 42%;
    }
  }
</style>
