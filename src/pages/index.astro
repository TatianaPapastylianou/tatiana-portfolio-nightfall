---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Frame from '../components/Frame.astro';
import LiveComponents from '../components/LiveComponents.astro';

const cases = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order);

// the sticky-left / scrolling-band work gallery: each case = pinned meta + a band
// of its framed screens (hero + first exhibits) scrolling past on the right.
const bandTilts = [-0.8, 0.7, -0.5];

// landing-page-only band overrides (leave the case pages on their own screens)
const landingBand: Record<string, { src: string; alt: string; orient: 'portrait' | 'landscape' }[]> = {
  'real-estate': [
    { src: '/cases/realestate-hero.svg', alt: '23 apps and services consolidated into 4 products', orient: 'landscape' },
    { src: '/cases/realestate-before.svg', alt: 'Before: 23 apps grouped by tenancy stage, with data copied between them', orient: 'landscape' },
    { src: '/cases/realestate-after.svg', alt: 'After: 4 products along one tenancy', orient: 'landscape' },
  ],
  'math-app': [
    { src: '/cases/math-home-1.jpg', alt: 'Akelius Education — numbers up to 1000, grade progress', orient: 'landscape' },
    { src: '/cases/math-home-2.jpg', alt: 'Akelius Education — your learning journey', orient: 'landscape' },
    { src: '/cases/math-home-3.jpg', alt: 'Akelius Education — welcome and explore', orient: 'landscape' },
  ],
};

const gallery = cases.map((c) => {
  const derived: { src: string; alt: string; orient: 'portrait' | 'landscape' }[] = [];
  if (c.data.hero.src) {
    derived.push({
      src: c.data.hero.src,
      alt: c.data.hero.alt ?? c.data.title,
      orient: c.data.hero.orient ?? 'portrait',
    });
  }
  c.data.exhibits.slice(0, 3 - derived.length).forEach((ex) => {
    derived.push({ src: ex.src, alt: ex.alt, orient: ex.orient ?? 'portrait' });
  });
  const band = landingBand[c.id] ?? derived;
  return {
    id: c.id,
    number: c.data.number,
    title: c.data.title,
    oneLiner: c.data.oneLiner,
    tag: c.data.tag ?? c.data.role,
    liveUrl: c.data.liveUrl,
    band,
  };
});

const impact = [
  { stat: '23 → 4', label: 'real estate apps consolidated into 4 products, used daily by about 200 staff' },
  { stat: '3 → 1', label: 'learning apps merged into Akelius Education, live on web, Android and iOS' },
  { stat: '24', label: 'core component families shared by web and Android, plus an iOS set' },
];

// "Shipped & published" proof — the instant credibility a recruiter needs in the
// first scroll: a live global product, three App Store apps, and a book in print.
// Gold stays on frames only; these are quiet ink plaques that each link out.
const proof = [
  {
    kind: 'iOS · App Store · 2026',
    name: 'Ludos',
    line: '20 mini-games, one app',
    icon: '/craft/ludos-appicon.jpg',
    href: 'https://apps.apple.com/app/ludos/id6797640259',
  },
  {
    kind: 'iOS · App Store',
    name: 'IrisVault',
    line: 'Eye-wellness · SwiftUI',
    icon: '/craft/irisvault-appicon.jpg',
    href: 'https://apps.apple.com/cy/app/irisvault-eye-exercises/id6764104619',
  },
  {
    kind: 'iOS · App Store',
    name: 'stePlan',
    line: 'Freelance planning',
    icon: '/craft/steplan-appicon.jpg',
    href: 'https://apps.apple.com/cy/app/steplan-freelancer-plan/id6762138338',
  },
  {
    kind: 'Book · 339 pages',
    name: 'No Water',
    line: 'A Designer’s Confession',
    icon: '/craft/no-water-cover.jpg',
    href: 'https://no-water-book.netlify.app/',
    book: true,
  },
];


---

<Base
  title="Tatiana Papastylianou · Senior Product Designer · Complex products and design systems"
  description="Senior Product Designer. I turn sprawling internal tools and multi-app products into clear systems: 23 real estate apps into 4 products, 3 learning apps into 1, one design system across web, iOS and Android."
  loader={true}
>
  <!-- hero: who, what, proof -->
  <header class="hero">
    <div class="container hero-grid">
      <div class="hero-copy" data-stagger>
        <p class="kicker reveal">Senior Product Designer · Design Lead</p>
        <h1 class="hero-name reveal">Tatiana<br />Papastylianou</h1>
        <p class="hero-statement reveal">
          I take products that grew in every direction and make them make sense again. Usually
          that means complex internal tools, merging apps, and the design system underneath.
        </p>
        <p class="hero-manifesto reveal">
          Five years at Akelius, across real estate tools for staff in seven countries and free
          learning apps on web, Android and iOS.
        </p>
        <a class="btn reveal hero-cta" href="#work">See the work <span aria-hidden="true">→</span></a>

        <ul class="hero-chips reveal" aria-label="At a glance">
          <li>Information architecture</li>
          <li>Design systems · web · iOS · Android</li>
          <li>B2B and consumer</li>
          <li>Designs and codes in SwiftUI</li>
        </ul>
      </div>

      <figure class="hero-frame reveal" data-parallax-scope>
        <div class="hero-frame-art" data-parallax="0.035">
          <Frame size="lg" tilt={-0.6} mat={false} live eager>
            <LiveComponents />
          </Frame>
        </div>
        <figcaption class="hero-plaque">
          <span class="hero-plaque-t">Go on, click it. These are real components from the design system.</span>
          <span class="hero-plaque-s">Design system · Akelius Education</span>
        </figcaption>
      </figure>
    </div>
  </header>

  <!-- selected impact -->
  <section class="section impact" aria-label="Selected impact">
    <div class="container">
      <p class="kicker reveal">Selected impact</p>
      <ul class="impact-grid" data-stagger>
        {
          impact.map((i) => (
            <li class="impact-item reveal">
              <span class="impact-stat" aria-label={i.stat.replace('→', 'to')} set:html={i.stat.replace('→', '<span class="arr" aria-hidden="true">→</span>')} />
              <span class="impact-label">{i.label}</span>
            </li>
          ))
        }
      </ul>
      <p class="impact-note reveal">Product metrics are under NDA, so these are scope numbers. Where a case uses an estimate, it says so.</p>
    </div>
  </section>

  <!-- the gallery: sticky-left meta + scrolling band of framed screens -->
  <section class="section work" id="work">
    <div class="container">
      <header class="work-head reveal">
        <p class="kicker">Selected work · <span class="num">five case studies</span></p>
        <h2 class="work-title">Case studies</h2>
      </header>

      <div class="gallery">
        {
          gallery.map((c) => (
            <article class="case-room">
              <div class="room-meta">
                <p class="kicker reveal">
                  <span class="num">{c.number}</span> · {c.tag}
                </p>
                <h3 class="room-title reveal">
                  <a href={`/work/${c.id}`}>{c.title}</a>
                </h3>
                <p class="room-line reveal">{c.oneLiner}</p>
                <div class="room-cta reveal">
                  <a class="textlink room-read" href={`/work/${c.id}`}>
                    View the case <span aria-hidden="true">→</span>
                  </a>
                  {c.liveUrl && (
                    <a class="room-live" href={c.liveUrl} target="_blank" rel="noopener">
                      Live ↗
                    </a>
                  )}
                </div>
              </div>

              <div class="room-band">
                {c.band.map((im, j) => (
                  <figure class="band-item reveal" data-parallax-scope>
                    <div class="band-art" data-parallax={j === 1 ? 0.055 : 0.03}>
                      <Frame
                        src={im.src}
                        alt={im.alt}
                        orient={im.orient}
                        size="md"
                        tilt={bandTilts[j % 3]}
                        href={`/work/${c.id}`}
                        label="View case →"
                        view
                      />
                    </div>
                  </figure>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- how I work: first person, uneven on purpose -->
  <section class="section method" aria-labelledby="method-title">
    <div class="container method-grid">
      <div class="method-head">
        <p class="kicker reveal">How I work</p>
        <h2 id="method-title" class="method-title reveal">Mostly, I draw the whole thing first.</h2>
      </div>
      <div class="method-body reveal">
        <p>
          Before I touch a screen, I map every app, who uses it and what data it owns. It's slow
          and not very photogenic. It's also why a brief to merge three apps ended up as
          <a href="/work/real-estate">23 apps rebuilt as 4 products</a>.
        </p>
        <p>
          When people with the power to overrule each other disagree, I stop arguing and build
          their versions. Seeing your own idea on a real screen settles more than a meeting does.
          That's how <a href="/work/math-app">Akelius Math</a> got unstuck.
        </p>
        <p>
          I'd rather find a missing screen in a prototype than in a sprint review.
          <a href="/work/unified-app">Case 04</a> had two.
        </p>
        <p>
          And once something works, I try to make it hard to break: tokens, Storybook, and lately
          <a href="/work/ai-skills">AI skills that check screens against our own rules</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- also shipped: side projects, after the work -->
  <section class="section proof" aria-labelledby="proof-title">
    <div class="container">
      <div class="proof-head reveal">
        <p class="kicker">Also shipped</p>
        <h2 id="proof-title" class="proof-title">Side projects I designed and built</h2>
        <p class="proof-sub">
          Three iOS apps, designed and coded in SwiftUI and live on the App Store, and a book.
          <a class="textlink" href="/craft">See side projects <span aria-hidden="true">→</span></a>
        </p>
      </div>
      <ul class="proof-grid" data-stagger>
        {
          proof.map((p) => (
            <li class="proof-item reveal">
              <a class="proof-link" href={p.href} target="_blank" rel="noopener">
                <span class:list={['proof-mark', { 'is-book': p.book, 'is-live': p.live }]}>
                  {p.icon ? (
                    <img src={p.icon} alt="" loading="lazy" />
                  ) : (
                    <span class="proof-livedot" aria-hidden="true" />
                  )}
                </span>
                <span class="proof-body">
                  <span class="proof-kind">{p.kind}</span>
                  <span class="proof-name">{p.name}</span>
                  <span class="proof-line">{p.line}</span>
                </span>
                <span class="proof-go" aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

</Base>

<style>
  /* hero */
  .hero {
    padding-block: clamp(2.5rem, 6vw, 5rem) var(--space-l);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr minmax(440px, 540px);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .hero-name {
    font-size: clamp(2.8rem, 1.8rem + 5vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin-top: 0.5rem;
  }
  .hero-statement {
    margin-top: var(--space-m);
    max-width: 34ch;
    font-family: var(--serif);
    font-size: var(--step-1);
    font-style: italic;
    color: var(--head);
    line-height: 1.3;
  }
  .hero-manifesto {
    margin-top: var(--space-m);
    max-width: 40ch;
    font-size: var(--step-0);
    color: var(--body);
  }
  .hero-manifesto cite {
    display: block;
    margin-top: 0.35rem;
    font-style: normal;
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    color: var(--dim);
  }
  .hero-cta {
    margin-top: var(--space-l);
  }
  /* at-a-glance credibility chips — the facts a recruiter wants fast */
  .hero-chips {
    list-style: none;
    padding: 0;
    margin-top: var(--space-l);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .hero-chips li {
    font-family: var(--sans);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--body);
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 100px;
    background: var(--card);
  }

  .hero-frame {
    margin: 0 auto;
    width: 100%;
    max-width: 540px;
  }
  .hero-frame-art {
    will-change: transform;
  }
  /* clean gallery wall-label: a gold hairline, an italic title, a tracked line */
  .hero-plaque {
    margin: 1.5rem auto 0;
    max-width: 34ch;
    text-align: center;
  }
  .hero-plaque::before {
    content: '';
    display: block;
    width: 30px;
    height: 1px;
    margin: 0 auto 0.9rem;
    background: var(--gold-deep);
    opacity: 0.5;
  }
  .hero-plaque-t {
    display: block;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.35;
    color: var(--head);
  }
  .hero-plaque-s {
    display: block;
    margin-top: 0.5rem;
    font-family: var(--sans);
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dim);
  }

  /* shipped & published proof band */
  .proof {
    padding-block: var(--space-xl);
    border-top: 1px solid var(--line);
  }
  .proof-head {
    max-width: 60ch;
    margin-bottom: var(--space-l);
  }
  .proof-title {
    font-size: var(--step-2);
    margin-top: 0.3rem;
  }
  .proof-sub {
    margin-top: var(--space-s);
    max-width: 56ch;
    color: var(--body);
    font-size: var(--step-0);
    line-height: 1.55;
  }
  .proof-grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: var(--space-s);
  }
  .proof-link {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    height: 100%;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-s);
    background: var(--card);
    color: var(--head);
    transition:
      border-color 0.25s var(--ease-out),
      transform 0.25s var(--ease-out),
      box-shadow 0.25s var(--ease-out);
  }
  .proof-link:hover {
    border-color: var(--line-strong);
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(60, 44, 24, 0.12);
  }
  .proof-mark {
    flex: 0 0 auto;
    width: 46px;
    height: 46px;
    border-radius: 11px;
    overflow: hidden;
    display: grid;
    place-items: center;
    background: var(--paper-2);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .proof-mark img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .proof-mark.is-book {
    border-radius: 3px 5px 5px 3px;
    border-left: 2px solid var(--gold-deep);
  }
  .proof-mark.is-live {
    background: var(--head);
  }
  .proof-livedot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 0 rgba(0, 165, 124, 0.5);
    animation: proofPulse 2.4s var(--ease-out) infinite;
  }
  @keyframes proofPulse {
    0% {
      box-shadow: 0 0 0 0 rgba(0, 165, 124, 0.45);
    }
    70% {
      box-shadow: 0 0 0 8px rgba(0, 165, 124, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(0, 165, 124, 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .proof-livedot {
      animation: none;
    }
  }
  .proof-body {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }
  .proof-kind {
    font-family: var(--sans);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .proof-name {
    font-family: var(--serif);
    font-size: var(--step-1);
    line-height: 1.1;
    color: var(--head);
  }
  .proof-line {
    font-size: var(--step--1);
    color: var(--dim);
  }
  .proof-go {
    margin-left: auto;
    align-self: flex-start;
    color: var(--dim);
    transition: transform 0.25s var(--ease-out);
  }
  .proof-link:hover .proof-go {
    transform: translate(3px, -3px);
    color: var(--head);
  }

  /* manifesto — a cinematic pause: gold light-wash + a faint watermark line */
  .manifesto {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(58% 90% at 22% 50%, rgba(201, 162, 75, 0.16), transparent 70%),
      var(--paper-2);
    border-block: 1px solid var(--line);
    padding-block: clamp(4rem, 12vw, 9rem);
  }
  .manifesto-mark {
    position: absolute;
    left: 50%;
    top: 52%;
    transform: translate(-50%, -50%) rotate(-4deg);
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(2.6rem, 11vw, 9rem);
    line-height: 1;
    color: rgba(60, 44, 24, 0.05);
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }
  .manifesto-inner {
    position: relative;
    z-index: 1;
  }
  .manifesto-line {
    margin-top: var(--space-m);
    max-width: 24ch;
    font-family: var(--serif);
    font-style: italic;
    font-size: var(--step-4);
    line-height: 1.08;
  }
  /* word-by-word scroll reveal: faint → ink as you read down the line */
  .manifesto-line .mword {
    color: var(--faint);
    transition: color 0.4s var(--ease-out);
  }
  .manifesto-line .mword.is-lit {
    color: var(--body);
  }
  .manifesto-line .mword.accent.is-lit {
    color: var(--gold-deep);
  }
  .no-js .manifesto-line .mword {
    color: var(--body);
  }
  .no-js .manifesto-line .mword.accent {
    color: var(--gold-deep);
  }
  .manifesto-cite {
    margin-top: var(--space-m);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    color: var(--dim);
  }

  /* impact */
  .impact-grid {
    list-style: none;
    padding: 0;
    margin-top: var(--space-l);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-l);
  }
  .impact-item {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .impact-stat {
    white-space: nowrap;
    font-family: var(--serif);
    font-size: var(--step-4);
    line-height: 1;
    color: var(--head);
  }
  .impact-stat :global(.arr) {
    display: inline-block;
    font-family: var(--sans);
    font-size: 0.6em;
    vertical-align: 0.32em;
    margin-inline: 0.12em;
  }
  .impact-label {
    color: var(--dim);
    font-size: var(--step-0);
    max-width: 26ch;
  }
  @media (max-width: 720px) {
    .impact-grid {
      grid-template-columns: 1fr;
      gap: var(--space-m);
    }
    .impact-item {
      flex-direction: row;
      align-items: baseline;
      gap: 1rem;
    }
    .impact-stat {
      font-size: var(--step-3);
    }
    /* art direction: each statement slides in from the left and settles a
       little further right than the one above — a cascading staircase, timed
       by the data-stagger delay so they arrive one after another. */
    .impact-item.reveal {
      transform: translateX(-40px);
      transition-duration: 0.9s;
    }
    .impact-item.reveal.is-in {
      transform: none;
    }
    .impact-item:nth-child(2) {
      margin-left: 1.5rem;
    }
    .impact-item:nth-child(3) {
      margin-left: 3rem;
    }
  }

  /* work head */
  .work-head {
    margin-bottom: var(--space-xl);
  }
  .work-title {
    font-size: var(--step-4);
    margin-top: 0.4rem;
  }

  /* the sticky-left / scrolling-band gallery */
  .case-room {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: clamp(2rem, 6vw, 5rem);
    padding-block: clamp(3rem, 8vw, 7rem);
    border-top: 1px solid var(--line);
  }
  .case-room:first-of-type {
    border-top: 0;
    padding-top: 0;
  }
  .room-meta {
    position: sticky;
    top: 110px;
    align-self: start;
  }
  .room-title {
    font-size: var(--step-3);
    margin-top: 0.6rem;
    line-height: 1.05;
  }
  .room-title a {
    color: var(--head);
    background-image: linear-gradient(var(--ink), var(--ink));
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.4s var(--ease-out);
  }
  .room-title a:hover {
    background-size: 100% 1px;
  }
  .room-line {
    margin-top: var(--space-m);
    max-width: 44ch;
    color: var(--body);
    font-size: var(--step-0);
    line-height: 1.55;
  }
  .room-cta {
    margin-top: var(--space-l);
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.6rem;
    align-items: center;
  }
  .room-read {
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .room-read span {
    display: inline-block;
    transition: transform 0.3s var(--ease-out);
  }
  .room-read:hover span {
    transform: translateX(5px);
  }
  .room-live {
    font-size: var(--step--1);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--gold-deep);
    border-bottom: 1px solid transparent;
  }
  .room-live:hover {
    border-bottom-color: var(--gold-deep);
  }
  .room-band {
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 6vw, 5rem);
  }
  .band-item {
    margin: 0;
  }

  @media (max-width: 820px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-frame {
      order: -1;
      max-width: 520px;
      width: 100%;
    }
    .case-room {
      grid-template-columns: 1fr;
      gap: var(--space-l);
      padding-block: var(--space-2xl);
    }
    .room-meta {
      position: static;
    }
  }

  /* craft teaser */
  .craft-teaser {
