---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Frame from '../components/Frame.astro';
import LiveComponents from '../components/LiveComponents.astro';

const cases = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order);

// the sticky-left / scrolling-band work gallery: each case = pinned meta + a band
// of its framed screens (hero + first exhibits) scrolling past on the right.
const bandTilts = [-0.8, 0.7, -0.5];
const gallery = cases.map((c) => {
  const band: { src: string; alt: string; orient: 'portrait' | 'landscape' }[] = [];
  if (c.data.hero.src) {
    band.push({
      src: c.data.hero.src,
      alt: c.data.hero.alt ?? c.data.title,
      orient: c.data.hero.orient ?? 'portrait',
    });
  }
  c.data.exhibits.slice(0, 3 - band.length).forEach((ex) => {
    band.push({ src: ex.src, alt: ex.alt, orient: ex.orient ?? 'portrait' });
  });
  return {
    id: c.id,
    number: c.data.number,
    title: c.data.title,
    oneLiner: c.data.oneLiner,
    tag: c.data.tag ?? c.data.role,
    liveUrl: c.data.liveUrl,
    band,
  };
});

const impact = [
  { stat: '3', label: 'platforms — web, iOS, Android — on one token system' },
  { stat: '24', label: 'core web component families designed & maintained' },
  { stat: 'Live', label: 'shipped free & worldwide — math.akelius.education' },
];

// the manifesto statement — revealed word-by-word on scroll ("read" as you go)
const manifesto =
  'A portfolio in 2026 sells judgement, not screens. Lead with the problem, the constraint, the choice, the consequence. The screens are only evidence.';
const manifestoWords = manifesto.split(' ');
---

<Base title="Tatiana Papastylianou — Senior Product Designer" loader={true}>
  <!-- hero: name + manifesto line, live-component frame -->
  <header class="hero">
    <div class="container hero-grid">
      <div class="hero-copy" data-stagger>
        <p class="kicker reveal">Senior Product Designer</p>
        <h1 class="hero-name reveal">Tatiana<br />Papastylianou</h1>
        <p class="hero-statement reveal">
          I build the systems behind serious products — and keep the work legible enough to
          trust.
        </p>
        <p class="hero-manifesto reveal">
          A portfolio sells <span class="accent">judgement</span>, not screens.
          <cite>— No Water, a designer's confession</cite>
        </p>
        <a class="btn reveal hero-cta" href="#work">Walk the gallery <span aria-hidden="true">→</span></a>
      </div>

      <figure class="hero-frame reveal" data-parallax-scope>
        <div class="hero-frame-art" data-parallax="0.035">
          <Frame size="lg" tilt={-0.6} mat={false} live>
            <LiveComponents />
          </Frame>
        </div>
        <figcaption class="hero-plaque">
          <span class="hero-plaque-t">The design system — real components, not screenshots</span>
          <span class="hero-plaque-s">01 · Design lead · Akelius</span>
        </figcaption>
      </figure>
    </div>
  </header>

  <!-- manifesto statement — a cinematic pause -->
  <section class="section manifesto" aria-label="Statement">
    <span class="manifesto-mark" aria-hidden="true">they care about how you think</span>
    <div class="container manifesto-inner">
      <p class="kicker reveal">The standard</p>
      <p class="manifesto-line reveal" aria-label={manifesto}>
        {
          manifestoWords.map((w) => (
            <>
              {/* prettier-ignore */}
              <span class:list={['mword', { accent: w.replace(/[.,]/g, '') === 'judgement' }]} aria-hidden="true">{w}</span>{' '}
            </>
          ))
        }
      </p>
      <p class="manifesto-cite reveal">Adapted from my book, <em>No Water — A Designer's Confession</em></p>
    </div>
  </section>

  <!-- selected impact -->
  <section class="section impact" aria-label="Selected impact">
    <div class="container">
      <p class="kicker reveal">Selected impact</p>
      <ul class="impact-grid" data-stagger>
        {
          impact.map((i) => (
            <li class="impact-item reveal">
              <span class="impact-stat">{i.stat}</span>
              <span class="impact-label">{i.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- the gallery: sticky-left meta + scrolling band of framed screens -->
  <section class="section work" id="work">
    <div class="container">
      <header class="work-head reveal">
        <p class="kicker">Selected work · <span class="num">three rooms</span></p>
        <h2 class="work-title">The collection</h2>
      </header>

      <div class="gallery">
        {
          gallery.map((c) => (
            <article class="case-room">
              <div class="room-meta">
                <p class="kicker reveal">
                  <span class="num">{c.number}</span> · {c.tag}
                </p>
                <h3 class="room-title reveal">
                  <a href={`/work/${c.id}`}>{c.title}</a>
                </h3>
                <p class="room-line reveal">{c.oneLiner}</p>
                <div class="room-cta reveal">
                  <a class="textlink room-read" href={`/work/${c.id}`}>
                    View the case <span aria-hidden="true">→</span>
                  </a>
                  {c.liveUrl && (
                    <a class="room-live" href={c.liveUrl} target="_blank" rel="noopener">
                      Live ↗
                    </a>
                  )}
                </div>
              </div>

              <div class="room-band">
                {c.band.map((im, j) => (
                  <figure class="band-item reveal" data-parallax-scope>
                    <div class="band-art" data-parallax={j === 1 ? 0.055 : 0.03}>
                      <Frame
                        src={im.src}
                        alt={im.alt}
                        orient={im.orient}
                        size="md"
                        tilt={bandTilts[j % 3]}
                        href={`/work/${c.id}`}
                        label="View case →"
                        view
                      />
                    </div>
                  </figure>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- craft teaser -->
  <section class="section craft-teaser">
    <div class="container craft-inner reveal">
      <div>
        <p class="kicker">Beyond the main hall</p>
        <h2 class="craft-title">Craft &amp; side rooms</h2>
        <p class="craft-copy">
          Instructional design for the Generator's column-operations lessons, a shipped iOS
          eye-wellness app, a freelance planning tool on the App Store, and a book —
          <em>No Water, A Designer's Confession</em>.
        </p>
      </div>
      <a class="btn" href="/craft">Enter the craft room</a>
    </div>
  </section>
</Base>

<style>
  /* hero */
  .hero {
    padding-block: clamp(2.5rem, 6vw, 5rem) var(--space-l);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr minmax(320px, 440px);
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: center;
  }
  .hero-name {
    font-size: clamp(2.8rem, 1.8rem + 5vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin-top: 0.5rem;
  }
  .hero-statement {
    margin-top: var(--space-m);
    max-width: 34ch;
    font-family: var(--serif);
    font-size: var(--step-1);
    font-style: italic;
    color: var(--head);
    line-height: 1.3;
  }
  .hero-manifesto {
    margin-top: var(--space-m);
    max-width: 40ch;
    font-size: var(--step-0);
    color: var(--body);
  }
  .hero-manifesto cite {
    display: block;
    margin-top: 0.35rem;
    font-style: normal;
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    color: var(--dim);
  }
  .hero-cta {
    margin-top: var(--space-l);
  }

  .hero-frame {
    margin: 0 auto;
    width: 100%;
    max-width: 440px;
  }
  .hero-frame-art {
    will-change: transform;
  }
  /* clean gallery wall-label: a gold hairline, an italic title, a tracked line */
  .hero-plaque {
    margin: 1.5rem auto 0;
    max-width: 34ch;
    text-align: center;
  }
  .hero-plaque::before {
    content: '';
    display: block;
    width: 30px;
    height: 1px;
    margin: 0 auto 0.9rem;
    background: var(--gold-deep);
    opacity: 0.5;
  }
  .hero-plaque-t {
    display: block;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.35;
    color: var(--head);
  }
  .hero-plaque-s {
    display: block;
    margin-top: 0.5rem;
    font-family: var(--sans);
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dim);
  }

  /* manifesto — a cinematic pause: gold light-wash + a faint watermark line */
  .manifesto {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(58% 90% at 22% 50%, rgba(201, 162, 75, 0.16), transparent 70%),
      var(--paper-2);
    border-block: 1px solid var(--line);
    padding-block: clamp(4rem, 12vw, 9rem);
  }
  .manifesto-mark {
    position: absolute;
    left: 50%;
    top: 52%;
    transform: translate(-50%, -50%) rotate(-4deg);
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(2.6rem, 11vw, 9rem);
    line-height: 1;
    color: rgba(60, 44, 24, 0.05);
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }
  .manifesto-inner {
    position: relative;
    z-index: 1;
  }
  .manifesto-line {
    margin-top: var(--space-m);
    max-width: 24ch;
    font-family: var(--serif);
    font-style: italic;
    font-size: var(--step-4);
    line-height: 1.08;
  }
  /* word-by-word scroll reveal: faint → ink as you read down the line */
  .manifesto-line .mword {
    color: var(--faint);
    transition: color 0.4s var(--ease-out);
  }
  .manifesto-line .mword.is-lit {
    color: var(--body);
  }
  .manifesto-line .mword.accent.is-lit {
    color: var(--gold-deep);
  }
  .no-js .manifesto-line .mword {
    color: var(--body);
  }
  .no-js .manifesto-line .mword.accent {
    color: var(--gold-deep);
  }
  .manifesto-cite {
    margin-top: var(--space-m);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    color: var(--dim);
  }

  /* impact */
  .impact-grid {
    list-style: none;
    padding: 0;
    margin-top: var(--space-l);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-l);
  }
  .impact-item {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .impact-stat {
    font-family: var(--serif);
    font-size: var(--step-4);
    line-height: 1;
    color: var(--head);
  }
  .impact-label {
    color: var(--dim);
    font-size: var(--step-0);
    max-width: 26ch;
  }
  @media (max-width: 720px) {
    .impact-grid {
      grid-template-columns: 1fr;
      gap: var(--space-m);
    }
    .impact-item {
      flex-direction: row;
      align-items: baseline;
      gap: 1rem;
    }
    .impact-stat {
      font-size: var(--step-3);
    }
  }

  /* work head */
  .work-head {
    margin-bottom: var(--space-xl);
  }
  .work-title {
    font-size: var(--step-4);
    margin-top: 0.4rem;
  }

  /* the sticky-left / scrolling-band gallery */
  .case-room {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: clamp(2rem, 6vw, 5rem);
    padding-block: clamp(3rem, 8vw, 7rem);
    border-top: 1px solid var(--line);
  }
  .case-room:first-of-type {
    border-top: 0;
    padding-top: 0;
  }
  .room-meta {
    position: sticky;
    top: 110px;
    align-self: start;
  }
  .room-title {
    font-size: var(--step-3);
    margin-top: 0.6rem;
    line-height: 1.05;
  }
  .room-title a {
    color: var(--head);
    background-image: linear-gradient(var(--ink), var(--ink));
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.4s var(--ease-out);
  }
  .room-title a:hover {
    background-size: 100% 1px;
  }
  .room-line {
    margin-top: var(--space-m);
    max-width: 44ch;
    color: var(--body);
    font-size: var(--step-0);
    line-height: 1.55;
  }
  .room-cta {
    margin-top: var(--space-l);
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.6rem;
    align-items: center;
  }
  .room-read {
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .room-read span {
    display: inline-block;
    transition: transform 0.3s var(--ease-out);
  }
  .room-read:hover span {
    transform: translateX(5px);
  }
  .room-live {
    font-size: var(--step--1);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--gold-deep);
    border-bottom: 1px solid transparent;
  }
  .room-live:hover {
    border-bottom-color: var(--gold-deep);
  }
  .room-band {
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 6vw, 5rem);
  }
  .band-item {
    margin: 0;
  }

  @media (max-width: 820px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-frame {
      order: -1;
      max-width: 520px;
      width: 100%;
    }
    .case-room {
      grid-template-columns: 1fr;
      gap: var(--space-l);
      padding-block: var(--space-2xl);
    }
    .room-meta {
      position: static;
    }
  }

  /* craft teaser */
  .craft-teaser {
    padding-block: var(--space-xl) var(--space-2xl);
  }
  .craft-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-l);
    padding: clamp(1.75rem, 4vw, 3rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--card);
  }
  .craft-title {
    font-size: var(--step-3);
    margin-top: 0.3rem;
  }
  .craft-copy {
    margin-top: var(--space-s);
    max-width: 52ch;
    color: var(--body);
  }
</style>
