---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Frame from '../components/Frame.astro';
import LiveComponents from '../components/LiveComponents.astro';
import CaseCard from '../components/CaseCard.astro';

const cases = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order);

// preview image for each case (live case falls back to its first exhibit)
const withPreview = cases.map((c, i) => ({
  ...c,
  preview: c.data.hero.src ?? c.data.exhibits[0]?.src ?? '',
  previewAlt: c.data.hero.alt ?? c.data.exhibits[0]?.alt ?? c.data.title,
  previewOrient: c.data.hero.orient ?? c.data.exhibits[0]?.orient ?? 'portrait',
  tilt: [-1.1, 1, -0.6][i % 3],
}));

const impact = [
  { stat: '3', label: 'platforms — web, iOS, Android — on one token system' },
  { stat: '24', label: 'core web component families designed & maintained' },
  { stat: 'Live', label: 'shipped free & worldwide — math.akelius.education' },
];

// the manifesto statement — revealed word-by-word on scroll ("read" as you go)
const manifesto =
  'A portfolio in 2026 sells judgement, not screens. Lead with the problem, the constraint, the choice, the consequence. The screens are only evidence.';
const manifestoWords = manifesto.split(' ');

// index rows: the three cases + the craft room
const indexRows = [
  ...withPreview.map((c) => ({
    number: c.data.number,
    label: c.data.role,
    title: c.data.title,
    href: `/work/${c.id}`,
    preview: c.preview,
    alt: c.previewAlt,
    orient: c.previewOrient,
  })),
  {
    number: '—',
    label: 'Craft & side rooms',
    title: 'Instructional design · IrisVault · stePlan · No Water',
    href: '/craft',
    preview: '/cases/ds-05-cards.jpg',
    alt: 'Craft room',
    orient: 'landscape' as const,
  },
];
---

<Base title="Tatiana Papastylianou — Senior Product Designer" loader={true}>
  <!-- hero: name + manifesto line, live-component frame -->
  <header class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="kicker reveal">Senior Product Designer</p>
        <h1 class="hero-name reveal">Tatiana<br />Papastylianou</h1>
        <p class="hero-statement reveal">
          I build the systems behind serious products — and keep the work legible enough to
          trust.
        </p>
        <p class="hero-manifesto reveal">
          A portfolio sells <span class="accent">judgement</span>, not screens.
          <cite>— No Water, a designer's confession</cite>
        </p>
        <a class="btn reveal hero-cta" href="#work">Walk the gallery <span aria-hidden="true">→</span></a>
      </div>

      <figure class="hero-frame reveal">
        <Frame size="lg" tilt={-0.6} mat={false} live>
          <LiveComponents />
        </Frame>
        <figcaption class="hero-plaque">
          <span class="hero-plaque-t">The design system — real components, not screenshots</span>
          <span class="hero-plaque-s">01 · Design lead · Akelius</span>
        </figcaption>
      </figure>
    </div>
  </header>

  <!-- manifesto statement -->
  <section class="section manifesto" aria-label="Statement">
    <div class="container">
      <p class="kicker reveal">The standard</p>
      <p class="manifesto-line reveal" aria-label={manifesto}>
        {
          manifestoWords.map((w) => (
            <>
              {/* prettier-ignore */}
              <span class:list={['mword', { accent: w.replace(/[.,]/g, '') === 'judgement' }]} aria-hidden="true">{w}</span>{' '}
            </>
          ))
        }
      </p>
      <p class="manifesto-cite reveal">Adapted from my book, <em>No Water — A Designer's Confession</em></p>
    </div>
  </section>

  <!-- selected impact -->
  <section class="section impact" aria-label="Selected impact">
    <div class="container">
      <p class="kicker reveal">Selected impact</p>
      <ul class="impact-grid">
        {
          impact.map((i) => (
            <li class="impact-item reveal">
              <span class="impact-stat">{i.stat}</span>
              <span class="impact-label">{i.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- case index: hover previews the framed screen -->
  <section class="section case-index" aria-label="Index of work" data-index-scope>
    <div class="container index-grid">
      <div class="index-preview" aria-hidden="true">
        <Frame src={indexRows[0].preview} alt="" orient={indexRows[0].orient} size="md" tilt={-0.6} />
      </div>
      <ol class="index-list">
        {
          indexRows.map((r) => (
            <li class="index-row">
              <a
                href={r.href}
                class="index-link"
                data-preview={r.preview}
                data-orient={r.orient}
                data-view
                data-label="View →"
              >
                <span class="index-num">{r.number}</span>
                <span class="index-titles">
                  <span class="index-title">{r.title}</span>
                  <span class="index-label">{r.label}</span>
                </span>
                <span class="index-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- the gallery: three framed cases -->
  <section class="section work" id="work">
    <div class="container">
      <header class="work-head reveal">
        <p class="kicker">The gallery · Selected work</p>
        <h2 class="work-title">Three rooms in the collection</h2>
        <p class="work-intro">
          A design system rebuilt as infrastructure, a live product shipped through three
          competing visions, and two apps merged and de-risked before a line of code. Step
          closer to any frame.
        </p>
      </header>

      <div class="work-list">
        {
          withPreview.map((c, i) => (
            <CaseCard
              number={c.data.number}
              role={c.data.role}
              title={c.data.title}
              oneLiner={c.data.oneLiner}
              slug={c.id}
              liveUrl={c.data.liveUrl}
              preview={c.preview}
              alt={c.previewAlt}
              orient={c.previewOrient}
              tilt={c.tilt}
              index={i}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- craft teaser -->
  <section class="section craft-teaser">
    <div class="container craft-inner reveal">
      <div>
        <p class="kicker">Beyond the main hall</p>
        <h2 class="craft-title">Craft &amp; side rooms</h2>
        <p class="craft-copy">
          Instructional design for the Generator's column-operations lessons, a shipped iOS
          eye-wellness app, a freelance planning tool on the App Store, and a book —
          <em>No Water, A Designer's Confession</em>.
        </p>
      </div>
      <a class="btn" href="/craft">Enter the craft room</a>
    </div>
  </section>
</Base>

<script>
  // case index — swap the shared preview frame (image + orientation) on hover/focus
  const fig = document.querySelector<HTMLElement>('.index-preview .frame');
  const fit = fig?.querySelector<HTMLImageElement>('img.fit');
  const fr = fig?.querySelector<HTMLImageElement>('img.fr');
  document.querySelectorAll<HTMLElement>('.index-link').forEach((link) => {
    const src = link.dataset.preview;
    const orient = link.dataset.orient === 'landscape' ? 'landscape' : 'portrait';
    const swap = () => {
      if (!fig || !fit || !fr || !src) return;
      fit.src = src;
      fig.classList.toggle('frame--landscape', orient === 'landscape');
      fig.classList.toggle('frame--portrait', orient !== 'landscape');
      fr.src =
        orient === 'landscape'
          ? '/frames/frame-cut-web-landscape.png'
          : '/frames/frame-cut-web.png';
    };
    link.addEventListener('pointerenter', swap);
    link.addEventListener('focus', swap);
  });
</script>

<style>
  /* hero */
  .hero {
    padding-block: clamp(2.5rem, 6vw, 5rem) var(--space-l);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr minmax(320px, 440px);
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: center;
  }
  .hero-name {
    font-size: clamp(2.8rem, 1.8rem + 5vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin-top: 0.5rem;
  }
  .hero-statement {
    margin-top: var(--space-m);
    max-width: 34ch;
    font-family: var(--serif);
    font-size: var(--step-1);
    font-style: italic;
    color: var(--head);
    line-height: 1.3;
  }
  .hero-manifesto {
    margin-top: var(--space-m);
    max-width: 40ch;
    font-size: var(--step-0);
    color: var(--body);
  }
  .hero-manifesto cite {
    display: block;
    margin-top: 0.35rem;
    font-style: normal;
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    color: var(--dim);
  }
  .hero-cta {
    margin-top: var(--space-l);
  }

  .hero-frame {
    margin: 0 auto;
    width: 100%;
    max-width: 440px;
  }
  /* clean gallery wall-label: a gold hairline, an italic title, a tracked line */
  .hero-plaque {
    margin: 1.5rem auto 0;
    max-width: 34ch;
    text-align: center;
  }
  .hero-plaque::before {
    content: '';
    display: block;
    width: 30px;
    height: 1px;
    margin: 0 auto 0.9rem;
    background: var(--gold-deep);
    opacity: 0.5;
  }
  .hero-plaque-t {
    display: block;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.35;
    color: var(--head);
  }
  .hero-plaque-s {
    display: block;
    margin-top: 0.5rem;
    font-family: var(--sans);
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dim);
  }

  /* manifesto */
  .manifesto {
    background: var(--paper-2);
    border-block: 1px solid var(--line);
  }
  .manifesto-line {
    margin-top: var(--space-m);
    max-width: 24ch;
    font-family: var(--serif);
    font-style: italic;
    font-size: var(--step-4);
    line-height: 1.08;
  }
  /* word-by-word scroll reveal: faint → ink as you read down the line */
  .manifesto-line .mword {
    color: var(--faint);
    transition: color 0.4s var(--ease-out);
  }
  .manifesto-line .mword.is-lit {
    color: var(--body);
  }
  .manifesto-line .mword.accent.is-lit {
    color: var(--gold-deep);
  }
  /* no-JS / reduced-motion: show the finished (read) state */
  .no-js .manifesto-line .mword {
    color: var(--body);
  }
  .no-js .manifesto-line .mword.accent {
    color: var(--gold-deep);
  }
  .manifesto-cite {
    margin-top: var(--space-m);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    color: var(--dim);
  }

  /* impact */
  .impact-grid {
    list-style: none;
    padding: 0;
    margin-top: var(--space-l);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-l);
  }
  .impact-item {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .impact-stat {
    font-family: var(--serif);
    font-size: var(--step-4);
    line-height: 1;
    color: var(--head);
  }
  .impact-label {
    color: var(--dim);
    font-size: var(--step-0);
    max-width: 26ch;
  }
  @media (max-width: 720px) {
    .impact-grid {
      grid-template-columns: 1fr;
      gap: var(--space-m);
    }
    .impact-item {
      flex-direction: row;
      align-items: baseline;
      gap: 1rem;
    }
    .impact-stat {
      font-size: var(--step-3);
    }
  }

  /* case index */
  .index-grid {
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .index-preview {
    position: sticky;
    top: 100px;
  }
  .index-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .index-link {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    padding: var(--space-m) 0;
    border-bottom: 1px solid var(--line);
    color: var(--head);
    transition: padding-left 0.3s var(--ease-out);
  }
  .index-link:hover,
  .index-link:focus-visible {
    padding-left: 0.8rem;
  }
  .index-num {
    font-family: var(--mono);
    font-size: var(--step--1);
    color: var(--gold-deep);
    min-width: 2ch;
  }
  .index-titles {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .index-title {
    font-family: var(--serif);
    font-size: var(--step-1);
    letter-spacing: 0.02em;
  }
  .index-label {
    font-size: var(--step--1);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .index-arrow {
    margin-left: auto;
    color: var(--gold-deep);
    transition: transform 0.3s var(--ease-out);
  }
  .index-link:hover .index-arrow {
    transform: translateX(6px);
  }
  @media (max-width: 820px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-frame {
      order: -1;
      max-width: 520px;
      width: 100%;
    }
    .index-grid {
      grid-template-columns: 1fr;
    }
    .index-preview {
      display: none;
    }
  }

  /* work head */
  .work-head {
    max-width: 60ch;
    margin-bottom: var(--space-l);
  }
  .work-title {
    font-size: var(--step-4);
    margin-top: 0.4rem;
  }
  .work-intro {
    margin-top: var(--space-s);
    color: var(--body);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  /* craft teaser */
  .craft-teaser {
    padding-block: var(--space-xl) var(--space-2xl);
  }
  .craft-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-l);
    padding: clamp(1.75rem, 4vw, 3rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--card);
  }
  .craft-title {
    font-size: var(--step-3);
    margin-top: 0.3rem;
  }
  .craft-copy {
    margin-top: var(--space-s);
    max-width: 52ch;
    color: var(--body);
  }
</style>
