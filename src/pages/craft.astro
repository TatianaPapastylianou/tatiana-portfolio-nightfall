---
import Base from '../layouts/Base.astro';
import Frame from '../components/Frame.astro';

// Column-operations lessons told as elegant sequential panels (graphic-novel restraint).
const panels = [
  {
    step: 'Problem',
    body: 'A maths professor’s column-operations method is rigorous but dense. On a small screen, a learner sees a wall of digits and carries — and gives up before the logic lands.',
  },
  {
    step: 'Decision',
    body: 'Teach the operation the way a patient tutor would: one column at a time, the carry appearing exactly when it happens, nothing on screen that the next move doesn’t need.',
  },
  {
    step: 'Craft',
    body: 'Instructional design as choreography — sequencing each reveal, aligning digits to a strict grid, and letting a single functional accent point to the one thing that just changed.',
  },
  {
    step: 'Outcome',
    body: 'The method reads as steps a person can follow, not a proof to decode. Built to sit inside the Generator’s authoring tools so editors can produce more lessons the same way.',
  },
];

// Smaller framed side-pieces. Live URLs left for the author to drop in — no invented links.
const pieces = [
  {
    kind: 'iOS · SwiftUI · Shipped',
    name: 'IrisVault',
    line: 'An eye-wellness companion for iOS — gentle reminders, exercises and rest habits for people who live on screens. Designed and shipped end-to-end in SwiftUI.',
    tone: 'aqua',
    tilt: -1.2,
    // href pending — no invented link
  },
  {
    kind: 'iOS · App Store · Freelance',
    name: 'stePlan',
    line: 'A freelance planning tool that reached the App Store — project and task planning distilled to the few moves a busy solo worker actually makes.',
    tone: 'gold',
    tilt: 1,
  },
  {
    kind: 'Book · Memoir',
    name: 'No Water — A Designer’s Confession',
    line: 'The true story of becoming a lead designer with no degree and no map — thirty-three chapters of shipped projects, hard conversations, and decisions still worth turning over, each closed by field notes on the craft.',
    tone: 'rose',
    tilt: -0.6,
    img: '/craft/no-water-cover.jpg',
    href: 'https://no-water-book.netlify.app/',
    external: true,
    cta: 'Read the first 25 pages ↗',
  },
];
---

<Base
  title="Craft — Tatiana Papastylianou"
  description="Instructional design for column-operations lessons, plus shipped side projects: IrisVault, stePlan, and the book No Water."
>
  <header class="section craft-head">
    <div class="container">
      <p class="kicker reveal">The craft room</p>
      <h1 class="craft-h1 reveal">Craft &amp; side rooms</h1>
      <p class="craft-lead reveal">
        Not everything is a flagship case. This room holds the smaller pieces — the teaching
        craft inside the product, and the things I’ve shipped on my own time.
      </p>
    </div>
  </header>

  <!-- Column operations, told in panels -->
  <section class="section spotlight" aria-labelledby="spotlight-title">
    <div class="container">
      <div class="spotlight-head reveal">
        <p class="kicker">Spotlight · Instructional design</p>
        <h2 id="spotlight-title" class="spotlight-title">Teaching column operations</h2>
        <p class="spotlight-intro">
          Turning a professor’s dense method into steps a learner can follow — the same
          problem → decision → outcome discipline as the cases, at the scale of a single lesson.
        </p>
      </div>

      <ol class="panels">
        {
          panels.map((p, i) => (
            <li class="panel reveal">
              <span class="panel-index" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="panel-step">{p.step}</span>
              <p class="panel-body">{p.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- side pieces as small framed tiles -->
  <section class="section pieces" aria-labelledby="pieces-title">
    <div class="container">
      <h2 id="pieces-title" class="pieces-title reveal">Framed side-pieces</h2>
      <ul class="pieces-grid">
        {
          pieces.map((p) => (
            <li class="piece reveal">
              <Frame
                size="sm"
                tilt={p.tilt}
                mat={!!p.img}
                src={p.img}
                alt={p.img ? `${p.name} — book cover` : undefined}
                href={p.href}
                external={p.external}
                label={p.external ? 'Open ↗' : 'Open →'}
                view={!!p.href}
              >
                {!p.img && (
                  <div class:list={['piece-art', `tone-${p.tone}`]}>
                    <span class="piece-initial">{p.name.charAt(0)}</span>
                  </div>
                )}
              </Frame>
              <p class="kicker piece-kind">{p.kind}</p>
              <h3 class="piece-name">
                {p.href ? (
                  <a href={p.href} {...(p.external ? { target: '_blank', rel: 'noopener' } : {})}>
                    {p.name}
                  </a>
                ) : (
                  p.name
                )}
              </h3>
              <p class="piece-line">{p.line}</p>
              {p.href ? (
                p.cta && (
                  <a
                    class="piece-cta"
                    href={p.href}
                    {...(p.external ? { target: '_blank', rel: 'noopener' } : {})}
                  >
                    {p.cta}
                  </a>
                )
              ) : (
                <p class="piece-note">Live link coming soon.</p>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .craft-head {
    padding-block: var(--space-2xl) var(--space-l);
  }
  .craft-h1 {
    font-size: var(--step-4);
    margin-top: 0.4rem;
  }
  .craft-lead {
    margin-top: var(--space-s);
    max-width: 56ch;
    font-size: var(--step-1);
    color: var(--body);
    line-height: 1.5;
  }

  .spotlight-head {
    max-width: 58ch;
    margin-bottom: var(--space-l);
  }
  .spotlight-title {
    font-size: var(--step-3);
    margin-top: 0.3rem;
  }
  .spotlight-intro {
    margin-top: var(--space-s);
    color: var(--body);
  }

  .panels {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .panel {
    background: var(--card);
    padding: clamp(1.4rem, 2.4vw, 2.1rem);
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    min-height: 240px;
  }
  .panel-index {
    font-family: var(--mono);
    font-size: var(--step--1);
    color: var(--gold-deep);
    letter-spacing: 0.1em;
  }
  .panel-step {
    font-family: var(--serif);
    font-size: var(--step-2);
    color: var(--head);
  }
  .panel-body {
    color: var(--body);
    font-size: var(--step--1);
    line-height: 1.6;
  }
  @media (max-width: 900px) {
    .panels {
      grid-template-columns: repeat(2, 1fr);
    }
    .panel {
      min-height: 0;
    }
  }
  @media (max-width: 520px) {
    .panels {
      grid-template-columns: 1fr;
    }
  }

  /* side pieces */
  .pieces {
    padding-block: var(--space-l) var(--space-2xl);
  }
  .pieces-title {
    font-size: var(--step-3);
    margin-bottom: var(--space-l);
  }
  .pieces-grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-l);
  }
  .piece {
    display: flex;
    flex-direction: column;
  }
  .piece-art {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: linear-gradient(160deg, #efe7d5, #e2d7bd);
  }
  .tone-aqua {
    background:
      radial-gradient(60% 60% at 60% 35%, rgba(46, 110, 126, 0.28), transparent 70%),
      linear-gradient(160deg, #eef0ea, #dfe6e2);
  }
  .tone-gold {
    background:
      radial-gradient(60% 60% at 35% 40%, rgba(201, 162, 75, 0.32), transparent 70%),
      linear-gradient(160deg, #f3ecd8, #e6d9b8);
  }
  .tone-rose {
    background:
      radial-gradient(60% 60% at 40% 65%, rgba(176, 106, 120, 0.28), transparent 70%),
      linear-gradient(160deg, #f1e7e4, #e6d3d3);
  }
  .piece-initial {
    font-family: var(--serif);
    font-style: italic;
    font-size: 3rem;
    color: rgba(33, 25, 19, 0.5);
  }
  .piece-kind {
    margin-top: var(--space-m);
    color: var(--gold-deep);
  }
  .piece-name {
    font-size: var(--step-2);
    margin-top: 0.3rem;
  }
  .piece-name a {
    color: var(--head);
    border-bottom: 1px solid transparent;
  }
  .piece-name a:hover {
    border-bottom-color: var(--ink);
  }
  .piece-line {
    margin-top: 0.6rem;
    color: var(--body);
    font-size: var(--step--1);
    line-height: 1.6;
  }
  .piece-note {
    margin-top: 0.5rem;
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    color: var(--dim);
  }
  .piece-cta {
    display: inline-block;
    margin-top: 0.7rem;
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
    border-bottom: 1px solid var(--ink);
    padding-bottom: 2px;
    transition: opacity 0.2s var(--ease-out);
  }
  .piece-cta:hover {
    opacity: 0.62;
  }
</style>
