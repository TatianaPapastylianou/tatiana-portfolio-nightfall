---
import Base from '../layouts/Base.astro';
import Frame from '../components/Frame.astro';

// Independent work: apps designed and built in SwiftUI, live on the App Store.
const apps = [
  {
    kind: 'Eye wellness · iOS · SwiftUI',
    name: 'IrisVault',
    line: 'Eye exercises, symptom check-ins and rest reminders for people who work on screens. Designed and built end to end.',
    img: '/craft/irisvault-screen.svg',
    tilt: -1.2,
    href: 'https://apps.apple.com/cy/app/irisvault-eye-exercises/id6764104619',
  },
  {
    kind: 'Planning · iOS · SwiftUI',
    name: 'stePlan',
    line: 'Project planning for freelancers, with steps, phases and a live client link. Connects to Claude through MCP, so a project can start from a chat.',
    img: '/craft/steplan-projects-list.jpg',
    tilt: 1,
    href: 'https://apps.apple.com/cy/app/steplan-freelancer-plan/id6762138338',
  },
  {
    kind: 'Games · iPhone & iPad · SwiftUI',
    name: 'Ludos',
    line: '20 mini-games in one free app: maths puzzles, party games, couples quizzes and eye-training drills for designers. No account needed.',
    img: '/craft/ludos-hero.jpg',
    tilt: -1,
    href: 'https://apps.apple.com/app/ludos/id6797640259',
  },
];

const book = {
  kind: 'Book · 339 pages · English and Russian',
  name: 'No Water: A Designer’s Confession',
  line: 'The true story of becoming a lead designer with no design degree and no map. Thirty-three chapters of shipped projects, hard conversations and decisions I still think about.',
  img: '/craft/no-water-cover.jpg',
  href: 'https://no-water-book.netlify.app/',
  cta: 'Read the first 25 pages ↗',
};
---

<Base
  title="Side projects — Tatiana Papastylianou"
  description="Independent work: three iOS apps designed and built in SwiftUI (IrisVault, stePlan, Ludos) and the book No Water, A Designer’s Confession."
>
  <header class="section craft-head">
    <div class="container">
      <p class="kicker reveal">Independent work</p>
      <h1 class="craft-h1 reveal">Side projects</h1>
      <p class="craft-lead reveal">
        I build what I design. Three iOS apps, designed and coded in SwiftUI and live on the App
        Store, and a book.
      </p>
    </div>
  </header>

  <!-- apps -->
  <section class="section pieces" aria-labelledby="apps-title">
    <div class="container">
      <h2 id="apps-title" class="pieces-title reveal">Apps</h2>
      <ul class="pieces-grid" data-stagger>
        {
          apps.map((p) => (
            <li class="piece reveal">
              <Frame
                src={p.img}
                alt={`${p.name}, ${p.kind}`}
                orient="portrait"
                size="sm"
                tilt={p.tilt}
                mat={false}
                fit="top"
                href={p.href}
                external
                label="Open ↗"
                view
              />
              <p class="kicker piece-kind">{p.kind}</p>
              <h3 class="piece-name">
                <a href={p.href} target="_blank" rel="noopener">
                  {p.name}
                </a>
              </h3>
              <p class="piece-line">{p.line}</p>
              <a class="piece-cta" href={p.href} target="_blank" rel="noopener">
                View on the App Store ↗
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- book -->
  <section class="section book" aria-labelledby="book-title">
    <div class="container">
      <h2 id="book-title" class="pieces-title reveal">Book</h2>
      <div class="book-row">
        <div class="book-frame reveal">
          <Frame
            src={book.img}
            alt={`${book.name} cover`}
            orient="portrait"
            size="sm"
            tilt={-0.6}
            mat
            href={book.href}
            external
            label="Open ↗"
            view
          />
        </div>
        <div class="book-note reveal">
          <p class="kicker piece-kind">{book.kind}</p>
          <h3 class="book-name">
            <a href={book.href} target="_blank" rel="noopener">
              {book.name}
            </a>
          </h3>
          <p class="book-line">{book.line}</p>
          <a class="piece-cta" href={book.href} target="_blank" rel="noopener">
            {book.cta}
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .craft-head {
    padding-block: var(--space-2xl) var(--space-l);
  }
  .craft-h1 {
    font-size: var(--step-4);
    margin-top: 0.4rem;
  }
  .craft-lead {
    margin-top: var(--space-s);
    max-width: 56ch;
    font-size: var(--step-1);
    color: var(--body);
    line-height: 1.5;
  }

  /* apps */
  .pieces {
    padding-block: var(--space-l) var(--space-xl);
  }
  .pieces-title {
    font-size: var(--step-3);
    margin-bottom: var(--space-l);
  }
  .pieces-grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-l);
  }
  .piece {
    display: flex;
    flex-direction: column;
  }
  /* fallback: push the link to the bottom of each card */
  .piece .piece-cta {
    margin-top: auto;
  }
  /* align frame, label, name, text and link rows across the cards in a row */
  @supports (grid-template-rows: subgrid) {
    .piece {
      display: grid;
      grid-template-rows: subgrid;
      grid-row: span 5;
      row-gap: 0;
    }
    .piece-kind {
      align-self: end;
    }
    .piece .piece-cta {
      align-self: start;
    }
  }
  .piece-kind {
    margin-top: var(--space-m);
    color: var(--gold-deep);
  }
  .piece-name {
    font-size: var(--step-2);
    margin-top: 0.3rem;
  }
  .piece-name a,
  .book-name a {
    color: var(--head);
    border-bottom: 1px solid transparent;
  }
  .piece-name a:hover,
  .book-name a:hover {
    border-bottom-color: var(--ink);
  }
  .piece-line {
    margin-top: 0.6rem;
    margin-bottom: 0.7rem;
    color: var(--body);
    font-size: var(--step--1);
    line-height: 1.6;
  }
  .piece-cta {
    display: inline-block;
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
    border-bottom: 1px solid var(--ink);
    padding-bottom: 2px;
    transition: opacity 0.2s var(--ease-out);
  }
  .piece-cta:hover {
    opacity: 0.62;
  }

  /* book: its own wide row, cover left, text right */
  .book {
    padding-block: var(--space-l) var(--space-2xl);
  }
  .book-row {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) 1.2fr;
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: center;
    padding-top: var(--space-l);
    border-top: 1px solid var(--line);
  }
  .book-note {
    max-width: 46ch;
  }
  .book-note .piece-kind {
    margin-top: 0;
  }
  .book-name {
    font-size: var(--step-3);
    margin-top: 0.3rem;
  }
  .book-line {
    margin-top: 0.8rem;
    margin-bottom: 1rem;
    color: var(--body);
    font-size: var(--step-0);
    line-height: 1.55;
  }
  @media (max-width: 820px) {
    .book-row {
      grid-template-columns: 1fr;
    }
  }
</style>
