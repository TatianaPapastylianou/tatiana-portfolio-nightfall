---
import Base from '../layouts/Base.astro';

// Column-operations lessons told as elegant sequential panels (graphic-novel restraint).
const panels = [
  {
    step: 'Problem',
    body: 'A maths professor’s column-operations method is rigorous but dense. On a small screen, a learner sees a wall of digits and carries — and gives up before the logic lands.',
  },
  {
    step: 'Decision',
    body: 'Teach the operation the way a patient tutor would: one column at a time, the carry appearing exactly when it happens, nothing on screen that the next move doesn’t need.',
  },
  {
    step: 'Craft',
    body: 'Instructional design as choreography — sequencing each reveal, aligning digits to a strict grid, and letting a single functional accent colour point to the one thing that just changed.',
  },
  {
    step: 'Outcome',
    body: 'The method reads as steps a person can follow, not a proof to decode. Built to sit inside the Generator’s authoring tools so editors can produce more lessons the same way.',
  },
];

// Smaller framed side-pieces. Live URLs left for the author to drop in — no invented links.
const pieces = [
  {
    kind: 'iOS · SwiftUI · Shipped',
    name: 'IrisVault',
    line: 'An eye-wellness companion for iOS — gentle reminders, exercises and rest habits for people who live on screens. Designed and shipped end-to-end in SwiftUI.',
    tone: 'tone-aqua',
    // url: 'https://apps.apple.com/...'
  },
  {
    kind: 'iOS · App Store · Freelance',
    name: 'stePlan',
    line: 'A freelance planning tool that reached the App Store — project and task planning distilled to the few moves a busy solo worker actually makes.',
    tone: 'tone-gold',
    // url: 'https://apps.apple.com/...'
  },
  {
    kind: 'Book · Landing',
    name: 'No Water — A Designer’s Confession',
    line: 'A book about design, doubt and the dark-dreamy inner world behind the work. The most personal thing in the collection — read more in the About room.',
    tone: 'tone-rose',
    href: '/about#book',
  },
];
---

<Base
  title="Craft — Tatiana Papastylianou"
  description="Instructional design for column-operations lessons, plus shipped side projects: IrisVault, stePlan, and the book No Water."
>
  <header class="section craft-head">
    <div class="container">
      <p class="eyebrow reveal">The craft room</p>
      <h1 class="craft-h1 reveal">Craft &amp; side rooms</h1>
      <p class="craft-lead reveal">
        Not everything is a flagship case. This room holds the smaller pieces — the teaching
        craft inside the product, and the things I’ve shipped on my own time.
      </p>
    </div>
  </header>

  <!-- Column operations, told in panels -->
  <section class="section spotlight" aria-labelledby="spotlight-title">
    <div class="container">
      <div class="spotlight-head reveal">
        <p class="eyebrow">Spotlight · Instructional design</p>
        <h2 id="spotlight-title" class="spotlight-title">Teaching column operations</h2>
        <p class="spotlight-intro">
          Turning a professor’s dense method into steps a learner can follow — the same
          problem→decision→outcome discipline as the cases, at the scale of a single lesson.
        </p>
      </div>

      <ol class="panels">
        {
          panels.map((p, i) => (
            <li class="panel reveal">
              <span class="panel-index" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="panel-step">{p.step}</span>
              <p class="panel-body">{p.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- side pieces as small framed tiles -->
  <section class="section pieces" aria-labelledby="pieces-title">
    <div class="container">
      <h2 id="pieces-title" class="pieces-title reveal">Framed side-pieces</h2>
      <ul class="pieces-grid">
        {
          pieces.map((p) => (
            <li class:list={['piece', 'reveal', p.tone]}>
              <div class="piece-frame">
                <div class="piece-art" aria-hidden="true">
                  <span class="piece-initial">{p.name.charAt(0)}</span>
                </div>
              </div>
              <p class="piece-kind">{p.kind}</p>
              <h3 class="piece-name">
                {p.href ? <a href={p.href}>{p.name}</a> : p.name}
              </h3>
              <p class="piece-line">{p.line}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .craft-head {
    padding-block: var(--space-2xl) var(--space-l);
  }
  .craft-h1 {
    font-size: var(--step-4);
    margin-top: 0.4rem;
    color: var(--parchment);
  }
  .craft-lead {
    margin-top: var(--space-s);
    max-width: 56ch;
    font-size: var(--step-1);
    color: var(--text-dim);
    line-height: 1.5;
  }

  /* spotlight panels */
  .spotlight-head {
    max-width: 58ch;
    margin-bottom: var(--space-l);
  }
  .spotlight-title {
    font-size: var(--step-3);
    margin-top: 0.3rem;
    color: var(--parchment);
  }
  .spotlight-intro {
    margin-top: var(--space-s);
    color: var(--text-dim);
  }

  .panels {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: rgba(200, 162, 75, 0.22);
    border: 1px solid rgba(200, 162, 75, 0.22);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .panel {
    background: var(--night-2);
    padding: clamp(1.4rem, 2.4vw, 2.1rem);
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    min-height: 240px;
  }

  .panel-index {
    font-family: var(--mono);
    font-size: var(--step--1);
    color: var(--gold);
    letter-spacing: 0.1em;
  }

  .panel-step {
    font-family: var(--serif);
    font-size: var(--step-2);
    color: var(--gold-lite);
  }

  .panel-body {
    color: var(--text-dim);
    font-size: var(--step--1);
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .panels {
      grid-template-columns: repeat(2, 1fr);
    }
    .panel {
      min-height: 0;
    }
  }
  @media (max-width: 520px) {
    .panels {
      grid-template-columns: 1fr;
    }
  }

  /* side pieces */
  .pieces {
    padding-block: var(--space-l) var(--space-2xl);
  }
  .pieces-title {
    font-size: var(--step-3);
    color: var(--parchment);
    margin-bottom: var(--space-l);
  }

  .pieces-grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-l);
  }

  .piece-frame {
    padding: 10px;
    border-radius: 5px;
    background: var(--frame-gold);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
    margin-bottom: var(--space-m);
  }

  .piece-art {
    aspect-ratio: 3 / 2;
    border-radius: 2px;
    display: grid;
    place-items: center;
    background: linear-gradient(160deg, #0b0e13, #182233);
  }

  .tone-aqua .piece-art {
    background:
      radial-gradient(60% 60% at 60% 35%, rgba(127, 184, 196, 0.4), transparent 70%),
      linear-gradient(160deg, #0b0e13, #101a26);
  }
  .tone-gold .piece-art {
    background:
      radial-gradient(60% 60% at 35% 40%, rgba(230, 200, 120, 0.35), transparent 70%),
      linear-gradient(160deg, #0b0e13, #182233);
  }
  .tone-rose .piece-art {
    background:
      radial-gradient(60% 60% at 40% 65%, rgba(176, 106, 120, 0.4), transparent 70%),
      linear-gradient(160deg, #0b0e13, #150f1a);
  }

  .piece-initial {
    font-family: var(--serif);
    font-style: italic;
    font-size: 3.4rem;
    color: rgba(243, 236, 221, 0.85);
    mix-blend-mode: overlay;
  }

  .piece-kind {
    font-family: var(--mono);
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .piece-name {
    font-size: var(--step-2);
    margin-top: 0.3rem;
    color: var(--parchment);
  }
  .piece-name a {
    color: inherit;
    text-decoration: none;
  }
  .piece-name a:hover {
    color: var(--gold-lite);
  }

  .piece-line {
    margin-top: 0.6rem;
    color: var(--text-dim);
    font-size: var(--step--1);
    line-height: 1.6;
  }
</style>
